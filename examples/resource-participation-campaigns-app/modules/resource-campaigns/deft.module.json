{
  "schema_version": "1",
  "id": "org.deft.reference.resource-campaigns",
  "slug": "resource-campaigns",
  "version": "1.0.0",
  "name": "Resource Campaigns",
  "description": "Campaigns owned by an independent Phase 4 proof App.",
  "icon": "megaphone",
  "collections": [
    {
      "key": "campaigns",
      "name": "Campaigns",
      "singular_name": "Campaign",
      "fields": [
        { "key": "name", "label": "Name", "type": "text", "required": true },
        { "key": "subject", "label": "Subject", "type": "text", "required": true },
        {
          "key": "status",
          "label": "Status",
          "type": "single_select",
          "options": [
            { "value": "draft", "label": "Draft" },
            { "value": "ready", "label": "Ready" },
            { "value": "paused", "label": "Paused" }
          ],
          "default": "draft"
        },
        { "key": "scheduled_for", "label": "Scheduled for", "type": "datetime" },
        { "key": "audience_notes", "label": "Audience notes", "type": "long_text" }
      ],
      "views": [
        { "key": "all", "name": "All campaigns", "type": "table", "fields": ["name", "subject", "status", "scheduled_for"] },
        { "key": "board", "name": "Campaign status", "type": "board", "group_by": "status", "fields": ["name", "subject", "scheduled_for"] },
        { "key": "form", "name": "Campaign form", "type": "form", "fields": ["name", "subject", "status", "scheduled_for", "audience_notes"] },
        { "key": "detail", "name": "Campaign details", "type": "detail", "fields": ["name", "subject", "status", "scheduled_for", "audience_notes"] }
      ],
      "search": {
        "title_field": "name",
        "subtitle_fields": ["subject", "status"],
        "fields": ["name", "subject", "status", "audience_notes"]
      }
    }
  ],
  "navigation": { "default_collection": "campaigns", "default_view": "all" }
}
