{
  "schema_version": "1",
  "id": "org.deft.reference.resource-campaigns-app",
  "version": "3.0.0",
  "name": "Connected Resource Campaigns",
  "description": "The connected Phase 5 upgrade of the Resource Campaigns proof App.",
  "license": "AGPL-3.0-only",
  "compatibility": { "app_protocol": "1" },
  "modules": [
    {
      "module_id": "org.deft.reference.resource-campaigns",
      "version": "3.0.0",
      "manifest_path": "modules/resource-campaigns/deft.module.json",
      "manifest_digest": "sha256:5dc2a978506eb2917a3a99021831d62d94112a60615292e4b32e03e480cff208"
    }
  ],
  "navigation": [
    {
      "key": "resource_campaigns",
      "label": "Resource Campaigns",
      "module_id": "org.deft.reference.resource-campaigns",
      "collection_key": "campaigns",
      "view_key": "all"
    }
  ],
  "dependencies": [
    {
      "key": "contacts_app",
      "app_id": "org.deft.reference.resource-contacts-app",
      "version": "1.0.0"
    }
  ],
  "resource_requirements": [
    {
      "key": "campaign",
      "source": {
