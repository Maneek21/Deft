{
  "name": "@deft/db",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./documents": "./src/documents-schema.ts",
    "./ics-publish-tokens": "./src/ics-publish-token-schema.ts",
    "./seat-statements": "./src/seat-statement-schema.ts",
    "./two-step": "./src/two-step-schema.ts"
  },
  "scripts": {
    "assert-fresh": "tsx scripts/assert-fresh.ts",
    "generate": "drizzle-kit generate",
    "push": "drizzle-kit push",
    "push-full": "tsx scripts/push-full.ts",
    "upgrade": "tsx scripts/upgrade.ts",
    "check:add-only-upgrades": "tsx scripts/add-only-upgrades.ts",
