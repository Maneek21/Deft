{
  "name": "@deft/app-kit",
  "version": "0.1.0-alpha.42",
  "description": "Portable authoring and packaging contract for declarative Deft apps.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-module-validator.mjs && tsc",
    "prepack": "pnpm build",
    "pretest": "pnpm build",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./experience": {
      "types": "./dist/experience-sdk.d.ts",
      "import": "./dist/experience-sdk.js"
    },
    "./experimental/resource-sync": {
      "types": "./dist/experimental/resource-sync.d.ts",
      "import": "./dist/experimental/resource-sync.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./experience/core": {
      "types": "./dist/experience-core.d.ts",
      "import": "./dist/experience-core.js"
    },
    "./examples/email": {
      "types": "./dist/examples/email/index.d.ts",
      "import": "./dist/examples/email/index.js"
    },
    "./examples/email/register": {
      "types": "./dist/examples/email/register.d.ts",
      "import": "./dist/examples/email/register.js"
    },
    "./examples/email/cli": {
      "types": "./dist/examples/email/cli.d.ts",
      "import": "./dist/examples/email/cli.js"
    }
  },
  "bin": {
    "deft": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "./dist/examples/email/sandbox.js",
    "./dist/examples/email/templates.js",
    "./dist/examples/email/register.js"
  ]
}
