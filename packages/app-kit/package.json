{
  "name": "@deft/app-kit",
  "version": "0.1.0-alpha.0",
  "description": "Portable authoring and packaging contract for declarative Deft apps.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "prepack": "pnpm build",
    "pretest": "pnpm build",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "deft": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
