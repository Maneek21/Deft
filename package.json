{
  "name": "deft",
  "private": true,
  "scripts": {
    "audit:session1": "tsx docs/superpowers/audits/agent-ui-session-1.audit.ts",
    "audit:session2": "tsx docs/superpowers/audits/agent-ui-session-2.audit.ts",
    "audit:session3": "tsx docs/superpowers/audits/agent-ui-session-3.audit.ts",
    "audit:openclaw-flow": "tsx docs/superpowers/audits/openclaw-employee-flow.audit.ts",
    "audit:agent-employees-ui": "tsx docs/superpowers/audits/agent-employees-ui.audit.ts",
    "audit:receipts": "tsx docs/superpowers/audits/audit-receipts.audit.ts",
    "audit:deploy-wizard": "tsx docs/superpowers/audits/deploy-wizard.audit.ts",
    "audit:metrics": "tsx docs/superpowers/audits/metrics-smoke.ts",
    "audit:setup": "tsx docs/superpowers/audits/setup-auth.ts",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @deft/db generate",
    "db:migrate": "pnpm --filter @deft/db migrate",
    "db:push": "pnpm --filter @deft/db push",
    "db:seed": "pnpm --filter @deft/db seed",
    "db:studio": "pnpm --filter @deft/db studio",
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @deft/api dev",
    "dev:web": "pnpm --filter @deft/web dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r --parallel typecheck"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright": "^1.59.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "msgpackr-extract"
    ]
  }
}
