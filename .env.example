# ═══════════════════════════════════════════════════════
# Deft — Environment Configuration
# Copy this to .env and fill in your values.
#
# Required for first boot: JWT_SECRET, JWT_REFRESH_SECRET, ANTHROPIC_API_KEY
# Everything else is optional unless noted.
# ═══════════════════════════════════════════════════════

# ── 1. Database & Redis ───────────────────────────────
# docker-compose overrides these automatically; only change when using
# an external Postgres / Redis instance.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/deft
REDIS_URL=redis://localhost:6379

# ── 2. Auth secrets ───────────────────────────────────
# Must be set. Generate each with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string
JWT_REFRESH_SECRET=change-me-to-another-random-string

# ── 3. AI provider keys ───────────────────────────────
# Anthropic Claude is the default engine for Defty and all native agent runs.
# Get your key at https://console.anthropic.com
# The app boots without this key but AI features are disabled.
ANTHROPIC_API_KEY=

# ── 4. URLs & ports ───────────────────────────────────
# Change these when deploying behind a custom domain or reverse proxy.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_PORT=3001

# ── 5. File storage ───────────────────────────────────
# Default: local filesystem at ./uploads (persisted via Docker volume).
# For Cloudflare R2, uncomment and fill in all four vars:
# R2_ENDPOINT=
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET=deft-uploads

# ── 6. Email (optional) ───────────────────────────────
# Required for password-reset and invite emails.
# Get your key at https://resend.com
RESEND_API_KEY=
FROM_EMAIL=noreply@deft.dev

# ── 7. Google OAuth (optional) ────────────────────────
# Enables "Sign in with Google". Leave blank to use email/password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 8. Metrics scrape token (optional) ────────────────
# Static bearer token Prometheus / Grafana Agent sends to GET /api/metrics.
# Leave unset to disable the scrape endpoint (returns 503).
# Generate with: openssl rand -hex 32
METRICS_SCRAPE_TOKEN=
