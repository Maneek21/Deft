# ═══════════════════════════════════════════════════════
# Deft — Environment Configuration
# Copy this to .env and fill in your values.
#
# Required for first boot: JWT_SECRET, JWT_REFRESH_SECRET, ANTHROPIC_API_KEY
# Everything else is optional unless noted.
# ═══════════════════════════════════════════════════════

# ── 1. Database & Redis ───────────────────────────────
# docker-compose overrides these automatically; only change when using
# an external Postgres / Redis instance.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/deft
REDIS_URL=redis://localhost:6379

# ── 2. Auth secrets ───────────────────────────────────
# Must be set. Generate each with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string
JWT_REFRESH_SECRET=change-me-to-another-random-string

# ── 3. AI provider keys (optional fallback) ───────────
# Per-org BYOK is the recommended path — set keys from
# Settings → AI in the app. These env values are used as
# a fallback when an org hasn't configured its own key.
# The app boots without any key; AI features are disabled
# until at least one provider is configured (env or org).
ANTHROPIC_API_KEY=

# ── 3a. OpenAI (optional fallback for embeddings + Whisper) ──
# Used as a fallback for vector search and voice transcription
# when an org hasn't configured its own embedding provider in
# Settings → AI. Leave blank to require per-org config.
OPENAI_API_KEY=

# ── 3b. Voice transcription (optional) ────────────────
# Default: 'local' — calls a Whisper container on $WHISPER_URL.
# Spin one up with:
#   docker run -d -p 9000:9000 --name deft-whisper \
#     onerahmet/openai-whisper-asr-webservice:latest-cpu
# Set TRANSCRIPTION_PROVIDER=openai (uses OPENAI_API_KEY) or
# 'deepgram' (uses DEEPGRAM_API_KEY) for managed alternatives.
# TRANSCRIPTION_PROVIDER=local
# WHISPER_URL=http://localhost:9000
# DEEPGRAM_API_KEY=

# ── 4. URLs & ports ───────────────────────────────────
# Change these when deploying behind a custom domain or reverse proxy.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_PORT=3001

# ── 5. File storage ───────────────────────────────────
# Default: local filesystem at ./uploads (persisted via Docker volume).
# For Cloudflare R2, uncomment and fill in all four vars:
# R2_ENDPOINT=
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET=deft-uploads

# ── 6. Google OAuth (optional) ────────────────────────
# Enables "Sign in with Google". Leave blank to use email/password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 7. Metrics scrape token (optional) ────────────────
# Static bearer token Prometheus / Grafana Agent sends to GET /api/metrics.
# Leave unset to disable the scrape endpoint (returns 503).
# Generate with: openssl rand -hex 32
METRICS_SCRAPE_TOKEN=
