# ═══════════════════════════════════════════════════════
# Deft — Environment Configuration
# Copy this to .env and fill in your values
# ═══════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/deft

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string
JWT_REFRESH_SECRET=change-me-to-another-random-string

# ── AI Agent (optional — app works without it) ────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Email (optional) ─────────────────────────────────
# Get your key at https://resend.com
RESEND_API_KEY=
FROM_EMAIL=noreply@deft.dev

# ── App URLs ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_PORT=3001

# ── File Storage ──────────────────────────────────────
# Default: local filesystem (./uploads)
# For Cloudflare R2, uncomment and configure:
# R2_ENDPOINT=
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET=deft-uploads

# ── Google OAuth (optional) ───────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Railway OAuth (Phase 8 — managed employee deployments) ───
# Register Deft as an OAuth app at https://railway.com/account/apps and
# set the callback URL to ${NEXT_PUBLIC_API_URL}/api/integrations/railway/callback.
# Scopes required: openid email profile workspace:admin offline_access
# Without these, the "Railway Managed" wizard card is disabled.
RAILWAY_OAUTH_CLIENT_ID=
RAILWAY_OAUTH_CLIENT_SECRET=
RAILWAY_OAUTH_REDIRECT_URI=http://localhost:3001/api/integrations/railway/callback

# ── Self-Hosted Mode (optional) ──────────────────────
# Set both to "true" when self-hosting Deft.
# Disables SaaS-only features (agent builder wizard) and
# enables self-hosted-only features (stdio MCP transport, BYOA agents).
DEFT_SELF_HOSTED=
NEXT_PUBLIC_DEFT_SELF_HOSTED=
