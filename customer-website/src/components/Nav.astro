---
import Logo from './brand/Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { GITHUB_URL } from '../config';

const links = [
  { href: '/workspace', label: 'Workspace' },
  { href: '/agents', label: 'Agents' },
  { href: '/use-cases', label: 'Use cases' },
  { href: '/security', label: 'Security' },
  { href: '/open-source', label: 'Open source' },
  { href: '/pricing', label: 'Pricing' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="sticky top-0 z-50 backdrop-blur-glass" style="background: color-mix(in oklab, var(--surface) 75%, transparent);">
  <div class="border-b border-ghost">
    <nav class="mx-auto flex h-14 max-w-[1200px] items-center justify-between px-6">
      <a href="/" class="flex items-center gap-2" aria-label="Deft home">
        <Logo class="h-6 w-auto" />
      </a>

      <div class="hidden items-center gap-1 md:flex">
        {links.map((l) => (
          <a
            href={l.href}
            class:list={[
              'rounded-md px-3 py-1.5 text-[13px] font-medium transition-colors',
              isActive(l.href)
                ? 'text-ink bg-surface-container'
                : 'text-ink-variant hover:text-ink hover:bg-surface-container',
            ]}
          >
            {l.label}
          </a>
        ))}
      </div>

      <div class="flex items-center gap-2">
        <ThemeToggle />
        <a
          href={GITHUB_URL}
          class="hidden h-8 items-center justify-center rounded-md px-3 text-[13px] font-medium text-ink-variant hover:text-ink hover:bg-surface-container md:inline-flex"
          aria-label="GitHub"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
          </svg>
        </a>
        <a
          href="/pricing#waitlist"
          class="hidden md:inline-flex h-8 items-center justify-center rounded-md bg-primary-container px-3 text-[13px] font-medium text-primary-on-container shadow-sm hover:opacity-90"
        >
          Join waitlist
        </a>
        <button
          id="mobile-menu-toggle"
          type="button"
          class="md:hidden inline-flex h-8 w-8 items-center justify-center rounded-md text-ink-variant hover:text-ink hover:bg-surface-container"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Toggle navigation menu"
        >
          <svg id="mobile-menu-icon-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
          <svg id="mobile-menu-icon-close" class="hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </nav>

    <div
      id="mobile-menu"
      class="md:hidden hidden border-t border-ghost"
      style="background: color-mix(in oklab, var(--surface) 95%, transparent);"
    >
      <div class="mx-auto max-w-[1200px] px-6 py-3 flex flex-col">
        {links.map((l) => (
          <a
            href={l.href}
            data-mobile-link
            class:list={[
              'block w-full border-b border-ghost py-3 text-[15px] font-medium transition-colors',
              isActive(l.href)
                ? 'text-ink'
                : 'text-ink-variant hover:text-ink',
            ]}
          >
            {l.label}
          </a>
        ))}
        <a
          href={GITHUB_URL}
          data-mobile-link
          class="block w-full border-b border-ghost py-3 text-[15px] font-medium text-ink-variant hover:text-ink"
        >
          GitHub
        </a>
        <a
          href="/pricing#waitlist"
          data-mobile-link
          class="mt-4 mb-2 inline-flex w-full items-center justify-center rounded-md bg-primary-container px-3 py-3 text-[15px] font-medium text-primary-on-container shadow-sm hover:opacity-90"
        >
          Join waitlist
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('mobile-menu-icon-open');
  const iconClose = document.getElementById('mobile-menu-icon-close');

  function setOpen(open: boolean) {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    menu.classList.toggle('hidden', !open);
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  }

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    setOpen(!isOpen);
  });

  document.querySelectorAll('[data-mobile-link]').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  const mql = window.matchMedia('(min-width: 768px)');
  const onChange = (e: MediaQueryListEvent) => {
    if (e.matches) setOpen(false);
  };
  if (mql.addEventListener) {
    mql.addEventListener('change', onChange);
  } else {
    // Safari < 14 fallback
    // @ts-ignore — deprecated but needed for older Safari
    mql.addListener(onChange);
  }
</script>
