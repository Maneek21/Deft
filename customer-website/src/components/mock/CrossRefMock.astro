---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['mock-window', className]} style="max-width: 880px; width: 100%; font-family: var(--font-sans, Inter, sans-serif);">
  <!-- Window chrome -->
  <div class="flex items-center gap-1.5 px-3 bg-surface-container-low" style="height: 28px; border-bottom: 1px solid var(--ghost-border);">
    <span class="rounded-full" style="width: 10px; height: 10px; background: var(--surface-container-highest);"></span>
    <span class="rounded-full" style="width: 10px; height: 10px; background: var(--surface-container-highest);"></span>
    <span class="rounded-full" style="width: 10px; height: 10px; background: var(--surface-container-highest);"></span>
    <span class="text-ink-outline ml-3" style="font-size: 11px;">Cross-surface reference</span>
  </div>

  <!-- Header -->
  <div class="bg-surface px-6 pt-5 pb-4" style="border-bottom: 1px solid var(--ghost-border);">
    <div class="eyebrow mb-1">How a single thread of work moves through Deft</div>
    <p class="text-ink-variant" style="font-size: 13px; margin: 0;">One conversation, automatically promoted to task, decision, and documentation.</p>
  </div>

  <!-- Flow diagram -->
  <div class="bg-surface px-6 py-6">
    <div class="flex flex-col md:flex-row md:items-stretch md:justify-between gap-4 md:gap-2">

      <!-- Node 1: Chat message -->
      <div class="flex-1 rounded-lg border border-ghost p-3 flex flex-col gap-2" style="background: var(--surface-container-low); min-width: 0;">
        <!-- label row -->
        <div class="flex items-center gap-1.5">
          <span class="flex items-center justify-center rounded-md flex-shrink-0" style="width: 20px; height: 20px; background: rgba(144, 128, 250, 0.15);">
            <svg width="11" height="11" viewBox="0 0 11 11" fill="none" style="color: var(--primary);">
              <path d="M1.5 2a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H5l-2 1.5V8H2.5a1 1 0 0 1-1-1V2Z" stroke="currentColor" stroke-width="1.1"/>
            </svg>
          </span>
          <span class="font-semibold" style="font-size: 11px; color: var(--primary);">Chat · #launch-q2</span>
        </div>
        <!-- body -->
        <p class="text-ink-variant" style="font-size: 12px; line-height: 1.5; flex: 1; margin: 0;">@maneek the auth migration is blocking the demo</p>
        <!-- footer -->
        <div class="font-mono text-ink-outline" style="font-size: 9px; padding-top: 6px; border-top: 1px solid var(--ghost-border);">messages.id: msg_8a2f</div>
      </div>

      <!-- Arrow 1: promoted to -->
      <div class="flex items-center justify-center md:flex-col md:justify-center flex-shrink-0" style="min-width: 64px;">
        <div class="flex flex-col items-center gap-1 md:flex-row md:gap-1.5">
          <span class="text-ink-outline" style="font-size: 16px; line-height: 1;">→</span>
          <span class="text-ink-outline" style="font-size: 10px; text-align: center;">promoted to</span>
        </div>
      </div>

      <!-- Node 2: Task -->
      <div class="flex-1 rounded-lg border border-ghost p-3 flex flex-col gap-2" style="background: var(--surface-container-low); min-width: 0;">
        <div class="flex items-center gap-1.5">
          <span class="flex items-center justify-center rounded-md flex-shrink-0" style="width: 20px; height: 20px; background: rgba(59, 130, 246, 0.12);">
            <svg width="11" height="11" viewBox="0 0 11 11" fill="none" style="color: var(--status-blue);">
              <circle cx="5.5" cy="5.5" r="4.5" stroke="currentColor" stroke-width="1.1"/>
              <path d="M3.5 5.5l1.5 1.5 3-3" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="font-semibold" style="font-size: 11px; color: var(--status-blue);">Task</span>
        </div>
        <p class="text-ink-variant" style="font-size: 12px; line-height: 1.5; flex: 1; margin: 0;">
          <span class="font-mono text-ink-outline" style="font-size: 10px;">ENG-142</span> · Replace cookie session with Postgres-backed sessions
        </p>
        <div class="font-mono text-ink-outline" style="font-size: 9px; padding-top: 6px; border-top: 1px solid var(--ghost-border);">tasks.id</div>
      </div>

      <!-- Arrow 2: captured as -->
      <div class="flex items-center justify-center md:flex-col md:justify-center flex-shrink-0" style="min-width: 64px;">
        <div class="flex flex-col items-center gap-1 md:flex-row md:gap-1.5">
          <span class="text-ink-outline" style="font-size: 16px; line-height: 1;">→</span>
          <span class="text-ink-outline" style="font-size: 10px; text-align: center;">captured as</span>
        </div>
      </div>

      <!-- Node 3: Decision -->
      <div class="flex-1 rounded-lg border border-ghost p-3 flex flex-col gap-2" style="background: var(--surface-container-low); min-width: 0;">
        <div class="flex items-center gap-1.5">
          <span class="flex items-center justify-center rounded-md flex-shrink-0" style="width: 20px; height: 20px; background: rgba(245, 166, 35, 0.12);">
            <svg width="11" height="11" viewBox="0 0 11 11" fill="none" style="color: var(--status-amber);">
              <rect x="1.5" y="1.5" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.1"/>
              <path d="M5.5 3.5v2.5M5.5 7.5v.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
            </svg>
          </span>
          <span class="font-semibold" style="font-size: 11px; color: var(--status-amber);">Decision</span>
        </div>
        <p class="text-ink-variant" style="font-size: 12px; line-height: 1.5; flex: 1; margin: 0;">Move session storage from cookie to Postgres</p>
        <div class="font-mono text-ink-outline" style="font-size: 9px; padding-top: 6px; border-top: 1px solid var(--ghost-border);">decisions.id · implemented</div>
      </div>

      <!-- Arrow 3: documented in -->
      <div class="flex items-center justify-center md:flex-col md:justify-center flex-shrink-0" style="min-width: 64px;">
        <div class="flex flex-col items-center gap-1 md:flex-row md:gap-1.5">
          <span class="text-ink-outline" style="font-size: 16px; line-height: 1;">→</span>
          <span class="text-ink-outline" style="font-size: 10px; text-align: center;">documented in</span>
        </div>
      </div>

      <!-- Node 4: Wiki page -->
      <div class="flex-1 rounded-lg border border-ghost p-3 flex flex-col gap-2" style="background: var(--surface-container-low); min-width: 0;">
        <div class="flex items-center gap-1.5">
          <span class="flex items-center justify-center rounded-md flex-shrink-0" style="width: 20px; height: 20px; background: rgba(48, 164, 108, 0.12);">
            <svg width="11" height="11" viewBox="0 0 11 11" fill="none" style="color: var(--status-green);">
              <rect x="1.5" y="1" width="8" height="9" rx="1.2" stroke="currentColor" stroke-width="1.1"/>
              <path d="M3.5 4h4M3.5 6h4M3.5 8h2.5" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
            </svg>
          </span>
          <span class="font-semibold" style="font-size: 11px; color: var(--status-green);">Wiki</span>
        </div>
        <p class="text-ink-variant" style="font-size: 12px; line-height: 1.5; flex: 1; margin: 0;">Auth middleware overview <span class="text-ink-outline" style="font-size: 11px;">(rev 14)</span></p>
        <div class="font-mono text-ink-outline" style="font-size: 9px; padding-top: 6px; border-top: 1px solid var(--ghost-border);">wiki_pages.id</div>
      </div>

    </div>

    <!-- Caption -->
    <p class="text-ink-variant text-center" style="font-size: 13px; margin: 24px 0 0;">All four are rows in the same Postgres. The agent joins them in one query.</p>
  </div>
</div>
