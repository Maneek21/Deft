---
interface Props {
  class?: string;
  framed?: boolean;
}
const { class: className = '', framed = true } = Astro.props;
---

<div
  class:list={[framed && 'mock-window', className]}
  style="font-family: var(--font-sans, Inter, sans-serif);"
>
  {framed && (
    <div class="flex items-center gap-1.5 px-3 bg-surface-container-low" style="height: 28px; border-bottom: 1px solid var(--ghost-border);">
      <span class="rounded-full" style="width: 10px; height: 10px; background: var(--surface-container-highest);"></span>
      <span class="rounded-full" style="width: 10px; height: 10px; background: var(--surface-container-highest);"></span>
      <span class="rounded-full" style="width: 10px; height: 10px; background: var(--surface-container-highest);"></span>
    </div>
  )}

  <div class="bg-surface" style="padding: 14px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; min-width: 560px;">

    <!-- BACKLOG column -->
    <div class="rounded-lg p-2.5" style="background: var(--surface-container-low);">
      <div class="flex items-center gap-2 mb-2.5">
        <span class="text-ink font-semibold" style="font-size: 12px;">Backlog</span>
        <span class="rounded-full font-mono text-ink-outline font-semibold" style="font-size: 10px; padding: 0 5px; height: 16px; line-height: 16px; background: var(--surface-container-high);">3</span>
        <button class="ml-auto text-ink-outline rounded" style="width: 18px; height: 18px; display: flex; align-items: center; justify-content: center; background: transparent; border: none; cursor: pointer; font-size: 14px; line-height: 1;">+</button>
      </div>
      <div class="flex flex-col gap-1.5">
        <!-- card -->
        <div class="rounded-lg p-2 border border-ghost" style="background: var(--surface-container);">
          <div class="flex items-center gap-1.5 mb-1">
            <span class="rounded-full" style="width: 4px; height: 4px; background: var(--status-red);"></span>
            <span class="font-mono text-ink-outline" style="font-size: 9px; text-transform: uppercase;">ENG-148</span>
          </div>
          <div class="text-ink" style="font-size: 11.5px; line-height: 1.35; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">Audit all dangerouslySetInnerHTML sites for XSS</div>
          <div class="flex items-center justify-between mt-1.5">
            <span class="font-mono text-ink-outline" style="font-size: 9px;">May 10</span>
            <span class="flex items-center justify-center rounded-full font-semibold text-white" style="width: 18px; height: 18px; background: var(--status-gray); font-size: 8px; flex-shrink: 0;">AK</span>
          </div>
        </div>
        <!-- card 2 -->
        <div class="rounded-lg p-2 border border-ghost" style="background: var(--surface-container);">
          <div class="flex items-center gap-1.5 mb-1">
            <span class="rounded-full" style="width: 4px; height: 4px; background: var(--status-amber);"></span>
            <span class="font-mono text-ink-outline" style="font-size: 9px; text-transform: uppercase;">ENG-150</span>
          </div>
          <div class="text-ink" style="font-size: 11.5px; line-height: 1.35; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">Add pgvector index on wiki_embeddings.vector</div>
          <div class="flex items-center justify-between mt-1.5">
            <span class="font-mono text-ink-outline" style="font-size: 9px;">May 12</span>
            <span class="flex items-center justify-center rounded-full font-semibold text-white" style="width: 18px; height: 18px; background: var(--status-blue); font-size: 8px; flex-shrink: 0;">MM</span>
          </div>
        </div>
        <!-- card 3 -->
        <div class="rounded-lg p-2 border border-ghost" style="background: var(--surface-container);">
          <div class="flex items-center gap-1.5 mb-1">
            <span class="rounded-full" style="width: 4px; height: 4px; background: var(--status-blue);"></span>
            <span class="font-mono text-ink-outline" style="font-size: 9px; text-transform: uppercase;">ENG-151</span>
          </div>
          <div class="text-ink" style="font-size: 11.5px; line-height: 1.35; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">Recurring tasks UI — clone recurrence source</div>
          <div class="flex items-center justify-between mt-1.5">
            <span class="font-mono text-ink-outline" style="font-size: 9px;">May 14</span>
            <span class="flex items-center justify-center rounded-full font-semibold text-white" style="width: 18px; height: 18px; background: var(--primary-container); font-size: 8px; flex-shrink: 0;">SR</span>
          </div>
        </div>
      </div>
    </div>

    <!-- IN PROGRESS column -->
    <div class="rounded-lg p-2.5" style="background: var(--surface-container-low);">
      <div class="flex items-center gap-2 mb-2.5">
        <span class="font-semibold" style="font-size: 12px; color: var(--status-amber);">In Progress</span>
        <span class="rounded-full font-mono font-semibold" style="font-size: 10px; padding: 0 5px; height: 16px; line-height: 16px; background: rgba(245, 166, 35, 0.15); color: var(--status-amber);">2</span>
        <button class="ml-auto text-ink-outline rounded" style="width: 18px; height: 18px; display: flex; align-items: center; justify-content: center; background: transparent; border: none; cursor: pointer; font-size: 14px; line-height: 1;">+</button>
      </div>
      <div class="flex flex-col gap-1.5">
        <div class="rounded-lg p-2 border border-ghost" style="background: var(--surface-container);">
          <div class="flex items-center gap-1.5 mb-1">
            <span class="rounded-full" style="width: 4px; height: 4px; background: var(--status-red);"></span>
            <span class="font-mono text-ink-outline" style="font-size: 9px; text-transform: uppercase;">ENG-142</span>
          </div>
          <div class="text-ink" style="font-size: 11.5px; line-height: 1.35; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">Migrate webhook auth to HMAC-SHA256</div>
          <div class="flex items-center justify-between mt-1.5">
            <span class="font-mono text-ink-outline" style="font-size: 9px;">May 6</span>
            <span class="flex items-center justify-center rounded-full font-semibold text-white" style="width: 18px; height: 18px; background: var(--status-amber); font-size: 8px; flex-shrink: 0;">MM</span>
          </div>
        </div>
        <div class="rounded-lg p-2 border border-ghost" style="background: var(--surface-container);">
          <div class="flex items-center gap-1.5 mb-1">
            <span class="rounded-full" style="width: 4px; height: 4px; background: var(--status-amber);"></span>
            <span class="font-mono text-ink-outline" style="font-size: 9px; text-transform: uppercase;">ENG-143</span>
          </div>
          <div class="text-ink" style="font-size: 11.5px; line-height: 1.35; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">Triage launch blockers — eng sync</div>
          <div class="flex items-center justify-between mt-1.5">
            <span class="font-mono text-ink-outline" style="font-size: 9px;">May 7</span>
            <span class="flex items-center justify-center rounded-full font-semibold text-white" style="width: 18px; height: 18px; background: var(--status-blue); font-size: 8px; flex-shrink: 0;">AK</span>
          </div>
        </div>
      </div>
    </div>

    <!-- DONE column -->
    <div class="rounded-lg p-2.5" style="background: var(--surface-container-low);">
      <div class="flex items-center gap-2 mb-2.5">
        <span class="font-semibold" style="font-size: 12px; color: var(--status-green);">Done</span>
        <span class="rounded-full font-mono font-semibold" style="font-size: 10px; padding: 0 5px; height: 16px; line-height: 16px; background: rgba(48, 164, 108, 0.15); color: var(--status-green);">2</span>
        <button class="ml-auto text-ink-outline rounded" style="width: 18px; height: 18px; display: flex; align-items: center; justify-content: center; background: transparent; border: none; cursor: pointer; font-size: 14px; line-height: 1;">+</button>
      </div>
      <div class="flex flex-col gap-1.5">
        <div class="rounded-lg p-2 border border-ghost" style="background: var(--surface-container); opacity: 0.8;">
          <div class="flex items-center gap-1.5 mb-1">
            <span class="rounded-full" style="width: 4px; height: 4px; background: var(--status-green);"></span>
            <span class="font-mono text-ink-outline" style="font-size: 9px; text-transform: uppercase; text-decoration: line-through;">ENG-131</span>
            <!-- PR pill -->
            <span class="rounded font-mono font-semibold ml-auto" style="font-size: 8px; padding: 1px 5px; background: rgba(48, 164, 108, 0.12); color: var(--status-green);">PR #1247</span>
          </div>
          <div class="text-ink-variant" style="font-size: 11.5px; line-height: 1.35; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; text-decoration: line-through;">DOMPurify XSS fix on message renderer</div>
          <div class="flex items-center justify-between mt-1.5">
            <span class="font-mono text-ink-outline" style="font-size: 9px;">May 3</span>
            <span class="flex items-center justify-center rounded-full font-semibold text-white" style="width: 18px; height: 18px; background: var(--status-green); font-size: 8px; flex-shrink: 0;">SR</span>
          </div>
        </div>
        <div class="rounded-lg p-2 border border-ghost" style="background: var(--surface-container); opacity: 0.8;">
          <div class="flex items-center gap-1.5 mb-1">
            <span class="rounded-full" style="width: 4px; height: 4px; background: var(--status-green);"></span>
            <span class="font-mono text-ink-outline" style="font-size: 9px; text-transform: uppercase; text-decoration: line-through;">ENG-128</span>
            <span class="rounded font-mono font-semibold ml-auto" style="font-size: 8px; padding: 1px 5px; background: rgba(48, 164, 108, 0.12); color: var(--status-green);">PR #1244</span>
          </div>
          <div class="text-ink-variant" style="font-size: 11.5px; line-height: 1.35; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; text-decoration: line-through;">Scroll containers for 9 settings pages</div>
          <div class="flex items-center justify-between mt-1.5">
            <span class="font-mono text-ink-outline" style="font-size: 9px;">May 2</span>
            <span class="flex items-center justify-center rounded-full font-semibold text-white" style="width: 18px; height: 18px; background: var(--status-amber); font-size: 8px; flex-shrink: 0;">MM</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>
