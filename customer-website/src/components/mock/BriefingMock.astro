---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['mock-window', className]} style="max-width: 600px; width: 100%; font-family: var(--font-sans, Inter, sans-serif);">
  <!-- Window chrome -->
  <div class="flex items-center gap-1.5 px-3 bg-surface-container-low" style="height: 28px; border-bottom: 1px solid var(--ghost-border);">
    <span class="rounded-full" style="width: 10px; height: 10px; background: var(--surface-container-highest);"></span>
    <span class="rounded-full" style="width: 10px; height: 10px; background: var(--surface-container-highest);"></span>
    <span class="rounded-full" style="width: 10px; height: 10px; background: var(--surface-container-highest);"></span>
    <!-- title -->
    <span class="text-ink font-semibold ml-3" style="font-size: 12px; flex: 1;">Tuesday morning briefing</span>
    <!-- by Defty -->
    <div class="flex items-center gap-1.5">
      <span class="flex items-center justify-center rounded-lg font-bold text-primary-on-container flex-shrink-0" style="width: 20px; height: 20px; background: var(--primary-container); font-size: 9px;">D</span>
      <span class="text-ink-outline" style="font-size: 11px;">by Defty · 8:00 AM</span>
    </div>
  </div>

  <!-- Body -->
  <div class="bg-surface" style="padding: 20px 24px 0;">
    <!-- subtitle -->
    <p class="text-ink-variant" style="font-size: 13px; line-height: 1.5; margin: 0 0 20px; padding-bottom: 20px; border-bottom: 1px solid var(--ghost-border);">Generated from yesterday's activity across tasks, PRs, decisions, and your calendar.</p>

    <!-- Section 1: What you finished -->
    <div class="mb-5">
      <div class="eyebrow mb-2.5 flex items-center gap-2">
        <span class="rounded-full flex-shrink-0" style="width: 6px; height: 6px; background: var(--status-green);"></span>
        <span style="color: var(--status-green);">What you finished yesterday</span>
      </div>
      <div class="flex flex-col gap-2">
        <div class="flex items-start gap-2.5">
          <svg width="13" height="13" viewBox="0 0 13 13" fill="none" style="color: var(--status-green); flex-shrink: 0; margin-top: 2px;"><path d="M2 6.5l3 3 6-6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="text-ink-variant" style="font-size: 13px; line-height: 1.5;">
            <span class="font-mono text-ink-outline" style="font-size: 11px;">ENG-141</span>
            {' '}· Add hmac_key_encrypted column
            <span class="text-ink-outline" style="font-size: 12px; margin-left: 6px;">(PR #1245 merged 4:12 PM)</span>
          </span>
        </div>
        <div class="flex items-start gap-2.5">
          <svg width="13" height="13" viewBox="0 0 13 13" fill="none" style="color: var(--status-green); flex-shrink: 0; margin-top: 2px;"><path d="M2 6.5l3 3 6-6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="text-ink-variant" style="font-size: 13px; line-height: 1.5;">
            <span class="font-mono text-ink-outline" style="font-size: 11px;">ENG-138</span>
            {' '}· Test for HMAC verification paths
          </span>
        </div>
        <div class="flex items-start gap-2.5">
          <svg width="13" height="13" viewBox="0 0 13 13" fill="none" style="color: var(--status-green); flex-shrink: 0; margin-top: 2px;"><path d="M2 6.5l3 3 6-6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="text-ink-variant" style="font-size: 13px; line-height: 1.5;">Closed 2 PRs across 3 spaces</span>
        </div>
      </div>
    </div>

    <!-- Section 2: What's blocking -->
    <div class="mb-5" style="padding-top: 16px; border-top: 1px solid var(--ghost-border);">
      <div class="eyebrow mb-2.5 flex items-center gap-2">
        <span class="rounded-full flex-shrink-0" style="width: 6px; height: 6px; background: var(--status-red);"></span>
        <span style="color: var(--status-red);">What's blocking</span>
      </div>
      <div class="flex items-start gap-2.5">
        <svg width="13" height="13" viewBox="0 0 13 13" fill="none" style="color: var(--status-red); flex-shrink: 0; margin-top: 2px;"><path d="M6.5 3v3.5M6.5 8.5v.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="6.5" cy="6.5" r="5" stroke="currentColor" stroke-width="1.2"/></svg>
        <span class="text-ink-variant" style="font-size: 13px; line-height: 1.5;">
          <span class="font-mono text-ink-outline" style="font-size: 11px;">ENG-142</span>
          {' '}· Replace cookie session — waiting on
          <span style="background: rgba(144, 128, 250, 0.15); color: var(--primary); padding: 1px 6px; border-radius: 4px; font-weight: 500; font-size: 12px;">@sara</span>
          {' '}review
        </span>
      </div>
    </div>

    <!-- Section 3: What needs decision -->
    <div class="mb-5" style="padding-top: 16px; border-top: 1px solid var(--ghost-border);">
      <div class="eyebrow mb-2.5 flex items-center gap-2">
        <span class="rounded-full flex-shrink-0" style="width: 6px; height: 6px; background: var(--status-amber);"></span>
        <span style="color: var(--status-amber);">What needs decision</span>
      </div>
      <div class="flex items-start gap-2.5">
        <svg width="13" height="13" viewBox="0 0 13 13" fill="none" style="color: var(--status-amber); flex-shrink: 0; margin-top: 2px;"><rect x="2" y="2" width="9" height="9" rx="1.5" stroke="currentColor" stroke-width="1.2"/><path d="M6.5 4.5v2.5M6.5 8.5v.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
        <span class="text-ink-variant" style="font-size: 13px; line-height: 1.5;">
          Should we deprecate the cookie session migration window after the Acme demo?
          <span class="text-ink-outline" style="font-size: 12px;"> (raised in </span>
          <span style="background: rgba(144, 128, 250, 0.1); color: var(--primary); padding: 0 5px; border-radius: 3px; font-size: 12px;">#launch-q2</span>
          <span class="text-ink-outline" style="font-size: 12px;">)</span>
        </span>
      </div>
    </div>

    <!-- Section 4: Today's calendar -->
    <div class="mb-0" style="padding-top: 16px; border-top: 1px solid var(--ghost-border);">
      <div class="eyebrow mb-2.5 flex items-center gap-2">
        <span class="rounded-full flex-shrink-0" style="width: 6px; height: 6px; background: var(--outline);"></span>
        <span>Today's calendar</span>
      </div>
      <div class="flex flex-col gap-2">
        <div class="flex items-center gap-2.5">
          <span class="font-mono text-ink-outline flex-shrink-0" style="font-size: 11px; width: 56px;">9:00 AM</span>
          <span class="text-ink-variant" style="font-size: 13px;">Standup #eng</span>
          <span class="status-pulse rounded-full ml-auto flex-shrink-0" style="width: 6px; height: 6px; background: var(--status-green);"></span>
        </div>
        <div class="flex items-center gap-2.5">
          <span class="font-mono text-ink-outline flex-shrink-0" style="font-size: 11px; width: 56px;">2:00 PM</span>
          <span class="text-ink-variant" style="font-size: 13px;">Customer demo · Acme</span>
          <span class="rounded-full ml-auto flex-shrink-0" style="width: 6px; height: 6px; background: var(--status-blue);"></span>
        </div>
        <div class="flex items-center gap-2.5">
          <span class="font-mono text-ink-outline flex-shrink-0" style="font-size: 11px; width: 56px;">4:00 PM</span>
          <span class="text-ink-variant" style="font-size: 13px;">Decision review: session storage</span>
          <span class="rounded-full ml-auto flex-shrink-0" style="width: 6px; height: 6px; background: var(--status-amber);"></span>
        </div>
      </div>
    </div>

  </div>

  <!-- Footer -->
  <div class="flex items-center gap-3 px-6 py-3" style="border-top: 1px solid var(--ghost-border); margin-top: 20px; background: var(--surface-container-low);">
    <button style="height: 28px; padding: 0 12px; font-size: 12px; font-weight: 500; background: transparent; border: 1px solid var(--ghost-border); border-radius: var(--radius-lg); color: var(--on-surface-variant); cursor: pointer;">Edit briefing</button>
    <button style="height: 28px; padding: 0 12px; font-size: 12px; font-weight: 600; background: var(--primary-container); color: var(--on-primary-container); border: none; border-radius: var(--radius-lg); cursor: pointer;">Mark read</button>
  </div>
</div>
