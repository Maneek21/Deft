---
/**
 * LiveLedgerMock — workspace-page hero animation.
 *
 * Concept: same data, two faces. Left pane = the human-readable UI
 * (one chat message, one task card). Right pane = the same content as
 * Postgres rows. Two beats on a 20s loop:
 *
 *   Beat 1 (0–8s)   — a person writes a chat message. The bubble appears
 *                     on the left and a `messages` row appears on the
 *                     right. Both flash violet at the same instant.
 *   Beat 2 (10–18s) — Defty updates the task. The status pill on the
 *                     left flips to `in_review`, the `tasks` row on the
 *                     right shows the same change. Both flash green.
 *
 * No JS. Pure CSS animations on a single shared 20s timeline so both
 * panes stay phase-locked. Honors prefers-reduced-motion.
 *
 * Schema names match packages/db/src/schema.ts (messages, tasks,
 * task_comments, project prefix `ENG`, status enum values).
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['live-ledger', className]} aria-hidden="true">
  <div class="ll-window">
    <!-- title bar -->
    <div class="ll-titlebar">
      <span class="ll-dot"></span>
      <span class="ll-dot"></span>
      <span class="ll-dot"></span>
      <span class="ll-titletext">deft.workspace</span>
    </div>

    <!-- pane labels with active-beat indicator -->
    <div class="ll-labels">
      <div class="ll-label">
        <span class="ll-label-eyebrow">What you see</span>
        <span class="ll-label-sub">the workspace UI</span>
      </div>
      <div class="ll-label ll-label-right">
        <span class="ll-label-eyebrow">What the agent sees</span>
        <span class="ll-label-sub">the same rows</span>
      </div>
    </div>

    <!-- event ticker — one line, names what's happening -->
    <div class="ll-ticker">
      <div class="ll-ticker-event ll-ev1">
        <span class="ll-ev-dot ll-ev-dot-human"></span>
        <span class="ll-ev-text">Maneek wrote a chat message</span>
      </div>
      <div class="ll-ticker-event ll-ev2">
        <span class="ll-ev-dot ll-ev-dot-agent"></span>
        <span class="ll-ev-text">Defty updated <span class="ll-mono">ENG-142</span></span>
      </div>
    </div>

    <!-- two panes -->
    <div class="ll-panes">

      <!-- ═══ LEFT — UI surface ═══ -->
      <div class="ll-pane">

        <!-- chat -->
        <div class="ll-chat">
          <div class="ll-chat-head">
            <span class="ll-chat-hash">#</span>
            <span class="ll-chat-name">launch-q2</span>
          </div>

          <div class="ll-msg ll-pair-1">
            <span class="ll-avatar ll-avatar-human">MM</span>
            <div class="ll-msg-body">
              <div class="ll-msg-meta">
                <span class="ll-msg-name">Maneek</span>
                <span class="ll-msg-time">10:34</span>
              </div>
              <p class="ll-msg-text">
                pushing the auth migration to next sprint —
                <span class="ll-mention">@alex</span> heads up
              </p>
            </div>
          </div>
        </div>

        <!-- task card -->
        <div class="ll-task ll-pair-2">
          <div class="ll-task-head">
            <span class="ll-task-id">ENG-142</span>
            <span class="ll-task-title">Auth migration</span>
          </div>
          <div class="ll-task-meta">
            <span class="ll-status">
              <span class="ll-status-old">in&nbsp;progress</span>
              <span class="ll-status-new">in&nbsp;review</span>
            </span>
            <span class="ll-due">
              <span class="ll-due-old">May&nbsp;9</span>
              <span class="ll-due-new">May&nbsp;23</span>
            </span>
          </div>
        </div>
      </div>

      <!-- seam -->
      <div class="ll-seam"></div>

      <!-- ═══ RIGHT — data surface ═══ -->
      <div class="ll-pane ll-pane-right">

        <!-- messages row — pair 1 -->
        <div class="ll-table ll-pair-1">
          <div class="ll-table-name">
            <span class="ll-table-icon">▾</span>
            messages
          </div>
          <div class="ll-row">
            <span class="ll-cell ll-cell-id">msg_8b2e</span>
            <span class="ll-cell ll-cell-user">u_maneek</span>
            <span class="ll-cell ll-cell-text">pushing the auth migration to next sprint…</span>
          </div>
        </div>

        <!-- tasks row — pair 2 -->
        <div class="ll-table ll-pair-2">
          <div class="ll-table-name">
            <span class="ll-table-icon">▾</span>
            tasks
          </div>
          <div class="ll-row">
            <span class="ll-cell ll-cell-id">tsk_eng142</span>
            <span class="ll-cell ll-cell-status">
              <span class="ll-cell-status-old">in_progress</span>
              <span class="ll-cell-status-new">in_review</span>
            </span>
            <span class="ll-cell ll-cell-text">Auth migration</span>
          </div>
          <!-- author byline shows up only during beat 2 -->
          <div class="ll-byline">
            updated by <span class="ll-byline-actor">deft-agent</span>
          </div>
        </div>
      </div>

    </div>

    <!-- caption inside the window -->
    <div class="ll-window-caption">
      Same writes. Both views. The agent reads the same rows you write to.
    </div>
  </div>
</div>

<style>
  /* ═══════════════════════════════════════════════════════════════
     LIVE LEDGER — workspace page hero animation
     ═══════════════════════════════════════════════════════════════ */

  .live-ledger {
    --ll-human: var(--primary, #C8BFFF);
    --ll-agent: var(--status-green, #30A46C);
    --ll-cycle: 20s;

    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    font-family: 'Inter', -apple-system, sans-serif;
  }

  /* outer chrome ─────────────────────────────────────────────── */
  .ll-window {
    background: var(--surface-container-low);
    border: 1px solid var(--ghost-border);
    border-radius: var(--radius-lg);
    box-shadow:
      0 24px 60px -20px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(144, 128, 250, 0.05);
    overflow: hidden;
  }
  .light .ll-window {
    box-shadow:
      0 24px 60px -20px rgba(0, 0, 0, 0.1),
      0 0 0 1px rgba(124, 107, 240, 0.06);
  }

  .ll-titlebar {
    height: 32px;
    padding: 0 12px;
    display: flex;
    align-items: center;
    gap: 7px;
    background: var(--surface-container);
    border-bottom: 1px solid var(--ghost-border);
  }
  .ll-dot {
    width: 9px; height: 9px; border-radius: 50%;
    background: var(--surface-container-highest);
  }
  .ll-titletext {
    margin-left: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--outline);
  }

  /* pane labels ──────────────────────────────────────────────── */
  .ll-labels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid var(--ghost-border);
    background: var(--surface);
  }
  .ll-label {
    padding: 14px 22px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .ll-label-right {
    border-left: 1px solid var(--ghost-border);
  }
  .ll-label-eyebrow {
    text-transform: uppercase;
    font-size: 10px;
    letter-spacing: 0.1em;
    font-weight: 600;
    color: var(--on-surface);
  }
  .ll-label-sub {
    font-size: 12px;
    color: var(--outline);
  }

  /* event ticker ─────────────────────────────────────────────── */
  .ll-ticker {
    position: relative;
    height: 36px;
    background: var(--surface);
    border-bottom: 1px solid var(--ghost-border);
    overflow: hidden;
  }
  .ll-ticker-event {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    font-size: 12px;
    color: var(--on-surface-variant);
    opacity: 0;
  }
  .ll-mono {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--on-surface);
    background: var(--surface-container);
    padding: 1px 5px;
    border-radius: 3px;
  }
  .ll-ev-dot {
    width: 6px; height: 6px; border-radius: 50%;
  }
  .ll-ev-dot-human { background: var(--ll-human); box-shadow: 0 0 8px var(--ll-human); }
  .ll-ev-dot-agent { background: var(--ll-agent); box-shadow: 0 0 8px var(--ll-agent); }

  .ll-ev1 { animation: ll-ev1 var(--ll-cycle) infinite ease-in-out; }
  .ll-ev2 { animation: ll-ev2 var(--ll-cycle) infinite ease-in-out; }
  @keyframes ll-ev1 {
    0%   { opacity: 0; }
    8%   { opacity: 1; }
    40%  { opacity: 1; }
    48%  { opacity: 0; }
    100% { opacity: 0; }
  }
  @keyframes ll-ev2 {
    0%   { opacity: 0; }
    50%  { opacity: 0; }
    58%  { opacity: 1; }
    90%  { opacity: 1; }
    98%  { opacity: 0; }
    100% { opacity: 0; }
  }

  /* panes ─────────────────────────────────────────────────────── */
  .ll-panes {
    display: grid;
    grid-template-columns: 1fr 1px 1fr;
    background: var(--surface);
  }
  .ll-pane {
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
    min-height: 320px;
  }
  .ll-seam { background: var(--ghost-border); }

  /* ═══ LEFT — UI ═══ */
  .ll-chat {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .ll-chat-head {
    display: flex;
    align-items: baseline;
    gap: 4px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--ghost-border);
  }
  .ll-chat-hash { font-size: 13px; color: var(--outline); font-weight: 600; }
  .ll-chat-name { font-size: 13px; color: var(--on-surface); font-weight: 600; }

  .ll-msg {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .ll-avatar {
    width: 28px; height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 700;
    color: white;
    flex-shrink: 0;
    margin-top: 1px;
  }
  .ll-avatar-human { background: var(--status-amber); }
  .ll-msg-body { min-width: 0; flex: 1; }
  .ll-msg-meta {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-bottom: 2px;
  }
  .ll-msg-name { font-size: 12px; font-weight: 600; color: var(--on-surface); }
  .ll-msg-time { font-size: 10px; color: var(--outline); font-family: 'JetBrains Mono', monospace; }
  .ll-msg-text { font-size: 13px; line-height: 1.45; color: var(--on-surface); margin: 0; }
  .ll-mention {
    background: rgba(144, 128, 250, 0.18);
    color: var(--ll-human);
    padding: 1px 5px;
    border-radius: 3px;
    font-weight: 500;
  }

  /* task card */
  .ll-task {
    margin-top: auto;
    border: 1px solid var(--ghost-border);
    border-radius: var(--radius-lg);
    padding: 12px 14px;
    background: var(--surface-container-low);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ll-task-head {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .ll-task-id {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    color: var(--outline);
  }
  .ll-task-title {
    font-size: 13px;
    font-weight: 500;
    color: var(--on-surface);
  }
  .ll-task-meta {
    display: flex;
    gap: 6px;
  }
  .ll-status, .ll-due {
    position: relative;
    font-size: 11px;
    font-weight: 500;
    padding: 3px 9px;
    border-radius: 999px;
    border: 1px solid var(--ghost-border);
    background: var(--surface-container);
    color: var(--on-surface-variant);
    height: 22px;
    display: inline-flex;
    align-items: center;
    overflow: hidden;
  }
  .ll-status-new, .ll-due-new {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(48, 164, 108, 0.14);
    color: var(--ll-agent);
    font-weight: 600;
    opacity: 0;
  }
  .ll-status-old, .ll-due-old {
    animation: ll-old-fade var(--ll-cycle) infinite linear;
  }
  .ll-status-new, .ll-due-new {
    animation: ll-new-fade var(--ll-cycle) infinite linear;
  }
  @keyframes ll-old-fade {
    0%, 56% { opacity: 1; }
    62%, 100% { opacity: 0; }
  }
  @keyframes ll-new-fade {
    0%, 56% { opacity: 0; }
    62%, 100% { opacity: 1; }
  }

  /* ═══ RIGHT — DATA ═══ */
  .ll-table {
    border: 1px solid var(--ghost-border);
    border-radius: 6px;
    background: var(--surface-container-low);
    overflow: hidden;
    transition: border-color 600ms ease, box-shadow 600ms ease;
  }
  .ll-table-name {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    color: var(--on-surface);
    padding: 7px 11px;
    background: var(--surface-container);
    border-bottom: 1px solid var(--ghost-border);
  }
  .ll-table-icon { color: var(--outline); font-size: 9px; }

  .ll-row {
    display: grid;
    grid-template-columns: 84px 84px 1fr;
    gap: 10px;
    padding: 9px 11px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    align-items: center;
  }
  .ll-cell-id { color: var(--ll-human); }
  .ll-cell-user { color: var(--on-surface-variant); }
  .ll-cell-text {
    color: var(--on-surface);
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ll-cell-status {
    position: relative;
    height: 18px;
    display: inline-flex;
    align-items: center;
  }
  .ll-cell-status-old {
    color: var(--status-blue);
    animation: ll-old-fade var(--ll-cycle) infinite linear;
  }
  .ll-cell-status-new {
    position: absolute;
    inset: 0;
    color: var(--ll-agent);
    opacity: 0;
    animation: ll-new-fade var(--ll-cycle) infinite linear;
  }

  .ll-byline {
    padding: 6px 11px 9px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: var(--outline);
    border-top: 1px solid var(--ghost-border);
    opacity: 0;
    animation: ll-byline-in var(--ll-cycle) infinite linear;
  }
  .ll-byline-actor { color: var(--ll-agent); font-weight: 600; }
  @keyframes ll-byline-in {
    0%, 56% { opacity: 0; }
    62%, 100% { opacity: 1; }
  }

  /* ═══ PAIR PULSES — same color, same instant, both panes ═══
     This is the whole point of the animation: when something writes,
     both views light up together to show they're the same row. */

  .ll-pair-1 {
    animation: ll-pulse-human var(--ll-cycle) infinite ease-out;
  }
  .ll-pair-2 {
    animation: ll-pulse-agent var(--ll-cycle) infinite ease-out;
  }

  /* Beat 1 fires at 8% (≈1.6s in), pair-1 elements glow violet. */
  @keyframes ll-pulse-human {
    0% {
      box-shadow: 0 0 0 0 rgba(144, 128, 250, 0);
      background-color: transparent;
    }
    8% {
      box-shadow: 0 0 0 4px rgba(144, 128, 250, 0.18);
      background-color: rgba(144, 128, 250, 0.08);
    }
    20% {
      box-shadow: 0 0 0 0 rgba(144, 128, 250, 0);
      background-color: transparent;
    }
    100% {
      box-shadow: 0 0 0 0 rgba(144, 128, 250, 0);
      background-color: transparent;
    }
  }
  /* Beat 2 fires at 58% (≈11.6s in), pair-2 elements glow green. */
  @keyframes ll-pulse-agent {
    0%, 56% {
      box-shadow: 0 0 0 0 rgba(48, 164, 108, 0);
      background-color: transparent;
    }
    62% {
      box-shadow: 0 0 0 4px rgba(48, 164, 108, 0.22);
      background-color: rgba(48, 164, 108, 0.1);
    }
    74% {
      box-shadow: 0 0 0 0 rgba(48, 164, 108, 0);
      background-color: transparent;
    }
    100% {
      box-shadow: 0 0 0 0 rgba(48, 164, 108, 0);
      background-color: transparent;
    }
  }

  /* The chat message starts hidden and fades in at the start of beat 1
     — but we want the pulse on the SAME element. So we attach the
     pulse to a wrapper, and fade the inner content separately. */
  .ll-msg.ll-pair-1 .ll-msg-body,
  .ll-msg.ll-pair-1 .ll-avatar {
    opacity: 0;
    animation: ll-fade-in-1 var(--ll-cycle) infinite linear;
  }
  .ll-table.ll-pair-1 .ll-row {
    opacity: 0;
    animation: ll-fade-in-1 var(--ll-cycle) infinite linear;
  }
  @keyframes ll-fade-in-1 {
    0%, 6%   { opacity: 0; transform: translateX(-3px); }
    10%, 100% { opacity: 1; transform: translateX(0); }
  }

  /* window caption — small, internal */
  .ll-window-caption {
    padding: 11px 22px;
    text-align: center;
    border-top: 1px solid var(--ghost-border);
    font-size: 12px;
    color: var(--outline);
    background: var(--surface-container-low);
  }

  /* ═══ RESPONSIVE ═══ */
  @media (max-width: 880px) {
    .ll-panes { grid-template-columns: 1fr; }
    .ll-seam { display: none; }
    .ll-pane { border-bottom: 1px solid var(--ghost-border); }
    .ll-pane-right { border-bottom: none; }
    .ll-labels { grid-template-columns: 1fr; }
    .ll-label-right {
      border-left: none;
      border-top: 1px solid var(--ghost-border);
    }
  }

  /* ═══ REDUCED MOTION — hold final-state ═══ */
  @media (prefers-reduced-motion: reduce) {
    .live-ledger *,
    .live-ledger *::before,
    .live-ledger *::after {
      animation: none !important;
      transition: none !important;
    }
    .ll-msg.ll-pair-1 .ll-msg-body,
    .ll-msg.ll-pair-1 .ll-avatar,
    .ll-table.ll-pair-1 .ll-row {
      opacity: 1 !important;
      transform: none !important;
    }
    .ll-status-old, .ll-due-old, .ll-cell-status-old { opacity: 0; }
    .ll-status-new, .ll-due-new, .ll-cell-status-new { opacity: 1; }
    .ll-byline { opacity: 1; }
    .ll-ev2 { opacity: 1; }
    .ll-ev1 { opacity: 0; }
  }
</style>
