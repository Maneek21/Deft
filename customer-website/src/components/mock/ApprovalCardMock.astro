---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['mock-window', className]} style="max-width: 520px; width: 100%; font-family: var(--font-sans, Inter, sans-serif);">
  <!-- Window chrome -->
  <div class="flex items-center gap-1.5 px-3 bg-surface-container-low" style="height: 28px; border-bottom: 1px solid var(--ghost-border);">
    <span class="rounded-full" style="width: 10px; height: 10px; background: var(--surface-container-highest);"></span>
    <span class="rounded-full" style="width: 10px; height: 10px; background: var(--surface-container-highest);"></span>
    <span class="rounded-full" style="width: 10px; height: 10px; background: var(--surface-container-highest);"></span>
  </div>

  <!-- Card body -->
  <div class="p-4 bg-surface" style="padding: 16px;">

    <!-- Agent header row -->
    <div class="flex items-center gap-2 mb-3">
      <span class="flex items-center justify-center rounded-lg font-bold text-primary-on-container flex-shrink-0" style="width: 28px; height: 28px; background: var(--primary-container); font-size: 12px;">D</span>
      <span class="text-ink font-semibold" style="font-size: 13px;">Defty</span>
      <span class="text-ink-outline" style="font-size: 11px; margin-left: 4px;">· 2m ago</span>
    </div>

    <!-- Plan title -->
    <div class="text-ink font-semibold mb-3" style="font-size: 15px;">Triage launch blockers</div>

    <!-- Steps -->
    <div class="flex flex-col gap-2 mb-4">

      <!-- Step 1 -->
      <div class="flex items-start gap-3">
        <span class="flex items-center justify-center rounded-full flex-shrink-0 text-ink-outline font-semibold" style="width: 20px; height: 20px; background: var(--surface-container-high); font-size: 10px; margin-top: 1px;">1</span>
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="text-ink font-medium" style="font-size: 13px;">Query open P1 tasks in ENG project</span>
            <span class="rounded font-bold" style="font-size: 9px; padding: 1px 5px; background: rgba(245, 166, 35, 0.15); color: var(--status-amber); letter-spacing: 0.04em; text-transform: uppercase;">WRITE</span>
          </div>
          <p class="text-ink-outline" style="font-size: 11px; margin: 2px 0 0; line-height: 1.4;">Fetch all tasks with priority p0–p1 where status != done.</p>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="flex items-start gap-3">
        <span class="flex items-center justify-center rounded-full flex-shrink-0 text-ink-outline font-semibold" style="width: 20px; height: 20px; background: var(--surface-container-high); font-size: 10px; margin-top: 1px;">2</span>
        <div class="flex-1 min-w-0">
          <span class="text-ink font-medium" style="font-size: 13px;">Summarize blockers and assignees</span>
          <p class="text-ink-outline" style="font-size: 11px; margin: 2px 0 0; line-height: 1.4;">Group by assignee, highlight overdue items and dependency chains.</p>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="flex items-start gap-3">
        <span class="flex items-center justify-center rounded-full flex-shrink-0 text-ink-outline font-semibold" style="width: 20px; height: 20px; background: var(--surface-container-high); font-size: 10px; margin-top: 1px;">3</span>
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="text-ink font-medium" style="font-size: 13px;">Post triage summary to #eng</span>
            <span class="rounded font-bold" style="font-size: 9px; padding: 1px 5px; background: rgba(59, 130, 246, 0.15); color: var(--status-blue); letter-spacing: 0.04em; text-transform: uppercase;">external</span>
          </div>
          <p class="text-ink-outline" style="font-size: 11px; margin: 2px 0 0; line-height: 1.4;">Message to Slack #eng — formatted with priority tiers.</p>
        </div>
      </div>

    </div>

    <!-- Footer actions -->
    <div class="flex items-center gap-2">
      <button style="height: 32px; padding: 0 12px; font-size: 13px; font-weight: 500; background: transparent; border: 1px solid var(--ghost-border); border-radius: var(--radius-lg); color: var(--on-surface-variant); cursor: pointer;">Reject</button>
      <button style="height: 32px; padding: 0 12px; font-size: 13px; font-weight: 600; background: var(--primary-container); color: var(--on-primary-container); border: none; border-radius: var(--radius-lg); cursor: pointer;">Approve</button>
    </div>

  </div>
</div>
