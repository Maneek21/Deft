---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['mock-window', className]} style="max-width: 520px; width: 100%; font-family: var(--font-sans, Inter, sans-serif);">
  <!-- Window chrome -->
  <div class="flex items-center gap-1.5 px-3 bg-surface-container-low" style="height: 28px; border-bottom: 1px solid var(--ghost-border);">
    <span class="rounded-full" style="width: 10px; height: 10px; background: var(--surface-container-highest);"></span>
    <span class="rounded-full" style="width: 10px; height: 10px; background: var(--surface-container-highest);"></span>
    <span class="rounded-full" style="width: 10px; height: 10px; background: var(--surface-container-highest);"></span>
    <!-- date + nav -->
    <div class="flex items-center gap-2 mx-auto">
      <button style="background: none; border: none; cursor: pointer; padding: 2px; color: var(--outline); display: flex; align-items: center;">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M7.5 2.5L4 6l3.5 3.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <span class="text-ink font-semibold" style="font-size: 12px;">Tuesday, April 21</span>
      <button style="background: none; border: none; cursor: pointer; padding: 2px; color: var(--outline); display: flex; align-items: center;">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4.5 2.5L8 6l-3.5 3.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
  </div>

  <!-- Calendar body -->
  <div class="bg-surface flex" style="min-height: 0;">

    <!-- Left: time gutter + event area -->
    <div class="flex-1 min-w-0 flex" style="padding: 8px 0 8px 0;">

      <!-- Time gutter -->
      <div class="flex-shrink-0" style="width: 44px; padding-top: 0;">
        {['8 AM','9 AM','10 AM','11 AM','12 PM','1 PM','2 PM','3 PM','4 PM','5 PM'].map((label) => (
          <div class="flex items-start justify-end pr-2 font-mono text-ink-outline" style="height: 56px; font-size: 9px; padding-top: 2px;">{label}</div>
        ))}
      </div>

      <!-- Events column -->
      <div class="flex-1 min-w-0 relative" style="border-left: 1px solid var(--ghost-border);">
        <!-- Hour lines -->
        {Array.from({length: 10}).map((_, i) => (
          <div style={`position: absolute; top: ${i * 56}px; left: 0; right: 0; height: 1px; background: var(--ghost-border); opacity: 0.6;`}></div>
        ))}

        <!-- Event 1: 9:00–9:15 AM → offset 56px from top (1 hour), height ~14px proportional to 15min -->
        <div class="absolute rounded-md flex items-start gap-1.5" style="top: 58px; left: 6px; right: 6px; height: 22px; background: rgba(144, 128, 250, 0.15); border-left: 2px solid var(--primary); padding: 3px 6px; overflow: hidden;">
          <span class="status-pulse rounded-full flex-shrink-0" style="width: 6px; height: 6px; background: var(--status-green); margin-top: 3px;"></span>
          <div class="flex-1 min-w-0 flex items-center gap-1.5 overflow-hidden">
            <span class="font-mono" style="font-size: 9px; color: var(--primary); flex-shrink: 0;">9:00</span>
            <span class="text-ink font-medium truncate" style="font-size: 11px;">Standup #eng</span>
            <span class="ml-auto flex-shrink-0" style="font-size: 9px; color: var(--primary); opacity: 0.7;">Deft</span>
          </div>
        </div>

        <!-- Event 2: 2:00–3:00 PM → offset (6 * 56) = 336px, height 56px -->
        <div class="absolute rounded-md flex flex-col" style="top: 338px; left: 6px; right: 6px; height: 52px; background: rgba(59, 130, 246, 0.12); border-left: 2px solid var(--status-blue); padding: 5px 8px; overflow: hidden;">
          <div class="flex items-center gap-1.5 mb-0.5">
            <span class="font-mono" style="font-size: 9px; color: var(--status-blue);">2:00 – 3:00 PM</span>
            <span class="ml-auto" style="font-size: 9px; color: var(--status-blue); opacity: 0.7;">Google Calendar</span>
          </div>
          <span class="text-ink font-medium" style="font-size: 12px; line-height: 1.2;">Customer demo · Acme</span>
        </div>

        <!-- Event 3: 4:00–4:30 PM → offset (8 * 56) = 448px, height 28px -->
        <div class="absolute rounded-md flex flex-col" style="top: 450px; left: 6px; right: 6px; height: 26px; background: rgba(245, 166, 35, 0.12); border-left: 2px solid var(--status-amber); padding: 3px 8px; overflow: hidden;">
          <div class="flex items-center gap-1.5">
            <span class="font-mono" style="font-size: 9px; color: var(--status-amber);">4:00</span>
            <span class="text-ink font-medium truncate" style="font-size: 11px;">Decision review: session storage</span>
            <span class="ml-auto flex-shrink-0" style="font-size: 9px; color: var(--status-amber); opacity: 0.7;">Deft</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right rail: Today's loop -->
    <div class="flex-shrink-0 flex flex-col" style="width: 156px; border-left: 1px solid var(--ghost-border); padding: 12px 12px; background: var(--surface-container-low);">
      <div class="text-ink font-semibold mb-3" style="font-size: 12px;">Today's loop</div>
      <div class="flex flex-col gap-2.5">
        <!-- line 1 -->
        <div class="flex items-start gap-2">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" style="color: var(--status-green); flex-shrink: 0; margin-top: 1px;"><path d="M2 6l2.5 2.5L10 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="text-ink-variant" style="font-size: 11px; line-height: 1.35;">4 PRs merged</span>
        </div>
        <!-- line 2 -->
        <div class="flex items-start gap-2">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" style="color: var(--status-green); flex-shrink: 0; margin-top: 1px;"><path d="M2 6l2.5 2.5L10 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="text-ink-variant" style="font-size: 11px; line-height: 1.35;">ENG-142 → done</span>
        </div>
        <!-- line 3 -->
        <div class="flex items-start gap-2">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" style="color: var(--outline); flex-shrink: 0; margin-top: 1px;"><circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1.2"/></svg>
          <span class="text-ink-variant" style="font-size: 11px; line-height: 1.35;">2 awaiting review</span>
        </div>
        <!-- line 4 -->
        <div class="flex items-start gap-2">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" style="color: var(--primary); flex-shrink: 0; margin-top: 1px;"><path d="M2 6h8M7 3l3 3-3 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="text-ink-variant" style="font-size: 11px; line-height: 1.35;">1 standup posted by Defty</span>
        </div>
      </div>
    </div>

  </div>

  <!-- Bottom strip -->
  <div class="flex items-center px-4" style="height: 26px; border-top: 1px solid var(--ghost-border); background: var(--surface-container-low);">
    <span style="font-size: 11px; color: var(--outline);">Synced from Google Calendar · last sync 2 min ago</span>
  </div>
</div>
