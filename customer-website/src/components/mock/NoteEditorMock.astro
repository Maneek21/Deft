---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['mock-window', className]} style="max-width: 560px; width: 100%; font-family: var(--font-sans, Inter, sans-serif);">
  <!-- Window chrome -->
  <div class="flex items-center gap-1.5 px-3 bg-surface-container-low" style="height: 28px; border-bottom: 1px solid var(--ghost-border);">
    <span class="rounded-full" style="width: 10px; height: 10px; background: var(--surface-container-highest);"></span>
    <span class="rounded-full" style="width: 10px; height: 10px; background: var(--surface-container-highest);"></span>
    <span class="rounded-full" style="width: 10px; height: 10px; background: var(--surface-container-highest);"></span>
    <!-- breadcrumb -->
    <div class="flex items-center gap-1 ml-3" style="flex: 1;">
      <span class="text-ink-outline" style="font-size: 11px;">Workspace</span>
      <span class="text-ink-outline" style="font-size: 11px; opacity: 0.5;">›</span>
      <span class="text-ink-outline" style="font-size: 11px;">Notes</span>
      <span class="text-ink-outline" style="font-size: 11px; opacity: 0.5;">›</span>
      <span class="text-ink-variant" style="font-size: 11px;">2026-04-21</span>
    </div>
    <!-- action icons -->
    <div class="flex items-center gap-2 ml-auto">
      <!-- search -->
      <svg width="13" height="13" viewBox="0 0 13 13" fill="none" style="color: var(--outline);">
        <circle cx="5.5" cy="5.5" r="4" stroke="currentColor" stroke-width="1.2"/>
        <path d="M8.5 8.5l2.5 2.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
      </svg>
      <!-- share -->
      <svg width="13" height="13" viewBox="0 0 13 13" fill="none" style="color: var(--outline);">
        <path d="M9 1.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM4 6.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM9 8.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3Z" fill="none" stroke="currentColor" stroke-width="1.2"/>
        <path d="M5.5 7.5l2-2M5.5 8.5l2 1" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
      </svg>
      <!-- more -->
      <svg width="13" height="13" viewBox="0 0 13 13" fill="none" style="color: var(--outline);">
        <circle cx="3" cy="6.5" r="1" fill="currentColor"/>
        <circle cx="6.5" cy="6.5" r="1" fill="currentColor"/>
        <circle cx="10" cy="6.5" r="1" fill="currentColor"/>
      </svg>
    </div>
  </div>

  <!-- Note body -->
  <div class="bg-surface" style="padding: 24px 28px 20px;">

    <!-- Eyebrow + title -->
    <div class="mb-4">
      <div class="eyebrow mb-1.5" style="color: var(--outline);">Daily note · Maneek</div>
      <h1 class="text-ink font-semibold" style="font-size: 18px; line-height: 1.3; margin: 0;">Auth migration sync — 2026-04-21</h1>
    </div>

    <!-- Body content -->
    <div style="line-height: 1.6; font-size: 14px;">

      <!-- H2: What we agreed -->
      <h2 class="text-ink font-semibold" style="font-size: 15px; margin: 0 0 10px; padding-bottom: 6px; border-bottom: 1px solid var(--ghost-border);">What we agreed</h2>

      <!-- Bullets -->
      <ul style="list-style: none; padding: 0; margin: 0 0 20px; display: flex; flex-direction: column; gap: 8px;">
        <li class="flex items-start gap-2.5">
          <span class="flex items-center justify-center flex-shrink-0 rounded-sm" style="width: 16px; height: 16px; border: 1.5px solid var(--outline); margin-top: 2px; background: transparent;">
            <svg width="9" height="9" viewBox="0 0 9 9" fill="none"><path d="M1.5 4.5l2 2 4-4" stroke="var(--status-green)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <span class="text-ink-variant">
            Ship migration 0061 by EOD Friday — confirmed with
            <span style="background: rgba(144, 128, 250, 0.2); color: var(--primary); padding: 1px 6px; border-radius: 4px; font-weight: 500; font-size: 13px;">@deft</span>
            to block-check dependencies first
          </span>
        </li>
        <li class="flex items-start gap-2.5">
          <span class="flex items-center justify-center flex-shrink-0 rounded-sm" style="width: 16px; height: 16px; border: 1.5px solid var(--outline); margin-top: 2px; background: transparent;">
            <svg width="9" height="9" viewBox="0 0 9 9" fill="none"><path d="M1.5 4.5l2 2 4-4" stroke="var(--status-green)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <span class="text-ink-variant">
            Backfill existing sessions after merge — tracked in
            <span style="background: rgba(144, 128, 250, 0.15); color: var(--primary); padding: 1px 7px; border-radius: 4px; font-weight: 500; font-size: 12px; font-family: 'JetBrains Mono', monospace;">ENG-142</span>
          </span>
        </li>
        <li class="flex items-start gap-2.5">
          <span class="flex-shrink-0 rounded-sm" style="width: 16px; height: 16px; border: 1.5px solid var(--outline); margin-top: 2px; background: transparent;"></span>
          <span class="text-ink-variant">Notify Acme team once sessions table is live</span>
        </li>
      </ul>

      <!-- H2: Open questions -->
      <h2 class="text-ink font-semibold" style="font-size: 15px; margin: 0 0 10px; padding-bottom: 6px; border-bottom: 1px solid var(--ghost-border);">Open questions</h2>

      <ul style="list-style: none; padding: 0; margin: 0 0 8px; display: flex; flex-direction: column; gap: 8px;">
        <li class="flex items-start gap-2.5">
          <span class="flex-shrink-0 rounded-sm" style="width: 16px; height: 16px; border: 1.5px solid var(--outline); margin-top: 2px; background: transparent;"></span>
          <span class="text-ink-variant">Do we deprecate the cookie fallback immediately or keep a dual-read window?</span>
        </li>
        <li class="flex items-start gap-2.5">
          <span class="flex-shrink-0 rounded-sm" style="width: 16px; height: 16px; border: 1.5px solid var(--outline); margin-top: 2px; background: transparent;"></span>
          <div class="flex-1 min-w-0">
            <span class="text-ink-variant block mb-2">How many stale sessions are currently in-flight?</span>
            <!-- Code block -->
            <div class="rounded-md p-3 font-mono" style="background: var(--surface-container-low); font-size: 12px; color: var(--on-surface-variant); line-height: 1.6; border: 1px solid var(--ghost-border);">
              <span style="color: var(--primary);">SELECT</span>
              <span> count(*) </span>
              <span style="color: var(--primary);">FROM</span>
              <span> sessions </span>
              <span style="color: var(--primary);">WHERE</span>
              <span> expires_at &lt; now();</span>
            </div>
          </div>
        </li>
      </ul>

    </div>
  </div>

  <!-- Footer status bar -->
  <div class="flex items-center gap-3 px-4" style="height: 28px; border-top: 1px solid var(--ghost-border); background: var(--surface-container-low);">
    <span style="font-size: 11px; color: var(--outline);">Auto-saved</span>
    <span style="font-size: 11px; color: var(--outline); opacity: 0.4;">·</span>
    <span style="font-size: 11px; color: var(--outline);">14 mentions</span>
    <span style="font-size: 11px; color: var(--outline); opacity: 0.4;">·</span>
    <span style="font-size: 11px; color: var(--outline);">linked to 3 tasks</span>
  </div>
</div>
