---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['mock-window', className]} style="font-family: var(--font-sans, Inter, sans-serif);">
  <!-- Window chrome -->
  <div class="flex items-center gap-1.5 px-3 bg-surface-container-low" style="height: 28px; border-bottom: 1px solid var(--ghost-border);">
    <span class="rounded-full" style="width: 10px; height: 10px; background: var(--surface-container-highest);"></span>
    <span class="rounded-full" style="width: 10px; height: 10px; background: var(--surface-container-highest);"></span>
    <span class="rounded-full" style="width: 10px; height: 10px; background: var(--surface-container-highest);"></span>
  </div>

  <!-- Two-column diff -->
  <div class="bg-surface" style="display: grid; grid-template-columns: 1fr 1fr; gap: 0;">

    <!-- LEFT — Other AI tools (red-tinted) -->
    <div style="padding: 16px; background: rgba(229, 72, 77, 0.04); border-right: 1px solid var(--ghost-border);">
      <!-- label -->
      <div class="flex items-center gap-2 mb-3">
        <span class="rounded-full" style="width: 6px; height: 6px; background: var(--status-red); flex-shrink: 0;"></span>
        <span class="eyebrow" style="color: var(--status-red); font-size: 10px;">Other AI tools</span>
      </div>

      <!-- Simulated chat with pasted context dump -->
      <div class="rounded-lg p-3 mb-3" style="background: var(--surface-container); border: 1px solid var(--ghost-border);">
        <div class="flex items-center gap-2 mb-2">
          <span class="rounded-full" style="width: 20px; height: 20px; background: var(--surface-container-high); display: flex; align-items: center; justify-content: center; font-size: 9px; color: var(--outline); font-weight: 600; flex-shrink: 0;">U</span>
          <span class="text-ink-outline" style="font-size: 11px; font-weight: 500;">You</span>
        </div>
        <p class="text-ink" style="font-size: 12px; line-height: 1.5; margin: 0 0 8px 0;">Here's the context, please summarize what we owe the customer:</p>
        <div class="rounded font-mono" style="font-size: 11px; padding: 8px 10px; background: var(--surface-container-high); color: var(--outline); line-height: 1.6; border: 1px solid var(--ghost-border);">
          <div>pasted_summary = """</div>
          <div style="opacity: 0.7;">On 2024-09-12, sara wrote in slack: "acme</div>
          <div style="opacity: 0.7;">wants migration before Q4..."</div>
          <div style="opacity: 0.7;">On 2024-09-19, alex replied: "confirmed, we</div>
          <div style="opacity: 0.7;">will freeze infra on Oct 1..."</div>
          <div style="opacity: 0.5;">On 2024-10-03, maneek wrote: "pushed to Oct</div>
          <div style="opacity: 0.4;">15 per customer request..."</div>
          <div style="opacity: 0.3;">[+2,847 more characters truncated]</div>
          <div>"""</div>
        </div>
        <p class="text-ink-outline mt-2" style="font-size: 10px; font-style: italic; margin: 6px 0 0;">Context window: 87% full. Some history may be cut off.</p>
      </div>

      <div class="flex items-center gap-1.5">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" style="color: var(--status-red); flex-shrink: 0;"><circle cx="6" cy="6" r="5" stroke="currentColor" stroke-width="1.2"/><path d="M6 4v2.5M6 8h.01" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
        <span class="text-ink-outline" style="font-size: 11px;">Manual copy-paste. Stale. Context-window limited.</span>
      </div>
    </div>

    <!-- RIGHT — Deft (green-tinted) -->
    <div style="padding: 16px; background: rgba(48, 164, 108, 0.04);">
      <!-- label -->
      <div class="flex items-center gap-2 mb-3">
        <span class="rounded-full status-pulse" style="width: 6px; height: 6px; background: var(--status-green); flex-shrink: 0;"></span>
        <span class="eyebrow" style="color: var(--status-green); font-size: 10px;">Deft</span>
      </div>

      <!-- SQL block -->
      <div class="rounded-lg mb-3" style="background: var(--surface-container-low); border: 1px solid var(--ghost-border); overflow: hidden;">
        <div class="flex items-center justify-between px-3" style="height: 28px; border-bottom: 1px solid var(--ghost-border); background: var(--surface-container);">
          <span class="text-ink-outline" style="font-size: 10px; font-family: var(--font-mono, monospace);">agent query</span>
          <span class="rounded" style="font-size: 9px; padding: 1px 6px; background: rgba(48, 164, 108, 0.12); color: var(--status-green); font-weight: 600;">LIVE</span>
        </div>
        <div class="font-mono" style="padding: 12px 14px; font-size: 12px; line-height: 1.7;">
          <div>
            <span style="color: var(--primary);">SELECT</span>
            <span class="text-ink"> t.id, t.title, e.payload</span>
          </div>
          <div>
            <span style="color: var(--primary);">FROM</span>
            <span class="text-ink"> tasks t</span>
          </div>
          <div>
            <span style="color: var(--primary);">JOIN</span>
            <span class="text-ink"> events e </span>
            <span style="color: var(--primary);">ON</span>
            <span class="text-ink"> e.task_id = t.id</span>
          </div>
          <div>
            <span style="color: var(--primary);">WHERE</span>
            <span class="text-ink"> t.org_id = $1</span>
          </div>
          <div>
            <span class="text-ink">&nbsp;&nbsp;</span>
            <span style="color: var(--primary);">AND</span>
            <span class="text-ink"> t.status = </span>
            <span style="color: var(--tertiary);">'in_progress'</span>
          </div>
          <div>
            <span style="color: var(--primary);">ORDER BY</span>
            <span class="text-ink"> t.updated_at </span>
            <span style="color: var(--primary);">DESC</span>
            <span class="text-ink">;</span>
          </div>
        </div>
      </div>

      <!-- Result row -->
      <div class="flex items-center gap-2 mb-3">
        <span class="font-mono" style="font-size: 11px; color: var(--status-green);">→ 14 rows · 22ms</span>
      </div>

      <div class="flex items-center gap-1.5">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" style="color: var(--status-green); flex-shrink: 0;"><path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span class="text-ink-outline" style="font-size: 11px;">Direct SQL. Always current. No pasting required.</span>
      </div>
    </div>

  </div>
</div>
