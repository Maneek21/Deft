---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['mock-window', className]} style="max-width: 640px; width: 100%; font-family: var(--font-sans, Inter, sans-serif);">
  <!-- Window chrome -->
  <div class="flex items-center gap-1.5 px-3 bg-surface-container-low" style="height: 28px; border-bottom: 1px solid var(--ghost-border);">
    <span class="rounded-full" style="width: 10px; height: 10px; background: var(--surface-container-highest);"></span>
    <span class="rounded-full" style="width: 10px; height: 10px; background: var(--surface-container-highest);"></span>
    <span class="rounded-full" style="width: 10px; height: 10px; background: var(--surface-container-highest);"></span>
    <span class="text-ink-outline ml-3" style="font-size: 11px;">Search</span>
  </div>

  <!-- Search input row -->
  <div class="bg-surface px-4 pt-4 pb-3" style="border-bottom: 1px solid var(--ghost-border);">
    <div class="flex items-center gap-2 rounded-lg px-3" style="height: 36px; background: var(--surface-container-low); border: 1px solid var(--ghost-border);">
      <!-- search icon -->
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" style="color: var(--outline); flex-shrink: 0;">
        <circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1.3"/>
        <path d="M9.5 9.5l3 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
      </svg>
      <span class="text-ink flex-1" style="font-size: 13px;">session token storage</span>
      <!-- kbd pill -->
      <span class="font-mono rounded text-ink-outline flex items-center justify-center" style="font-size: 10px; padding: 1px 5px; border: 1px solid var(--ghost-border); background: var(--surface-container); height: 18px;">⌘K</span>
      <!-- clear -->
      <button style="font-size: 11px; color: var(--outline); background: none; border: none; cursor: pointer; padding: 0; display: flex; align-items: center; gap: 2px;">
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none" style="flex-shrink: 0;"><path d="M2 2l6 6M8 2l-6 6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
        <span>clear</span>
      </button>
    </div>
  </div>

  <!-- Tab pills -->
  <div class="flex items-center gap-1.5 px-4 py-2.5 bg-surface" style="border-bottom: 1px solid var(--ghost-border);">
    <button class="rounded-md font-semibold" style="font-size: 11px; padding: 3px 9px; background: var(--primary-container); color: var(--on-primary-container); border: none; cursor: pointer;">All (8)</button>
    <button class="rounded-md text-ink-variant" style="font-size: 11px; padding: 3px 9px; background: transparent; border: 1px solid var(--ghost-border); cursor: pointer;">Wiki (3)</button>
    <button class="rounded-md text-ink-variant" style="font-size: 11px; padding: 3px 9px; background: transparent; border: 1px solid var(--ghost-border); cursor: pointer;">Decisions (2)</button>
    <button class="rounded-md text-ink-variant" style="font-size: 11px; padding: 3px 9px; background: transparent; border: 1px solid var(--ghost-border); cursor: pointer;">Tasks (3)</button>
  </div>

  <!-- Results list -->
  <div class="bg-surface flex flex-col" style="divide-color: var(--ghost-border);">

    <!-- Result 1 — Wiki page -->
    <div class="flex items-start gap-3 px-4 py-3 cursor-pointer" style="border-bottom: 1px solid var(--ghost-border); transition: background 120ms;" onmouseenter="this.style.background='var(--surface-container-high)'" onmouseleave="this.style.background=''">
      <!-- icon -->
      <span class="flex items-center justify-center rounded-md flex-shrink-0" style="width: 28px; height: 28px; background: rgba(144, 128, 250, 0.12); margin-top: 1px;">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" style="color: var(--primary);">
          <rect x="2" y="1.5" width="10" height="11" rx="1.5" stroke="currentColor" stroke-width="1.2"/>
          <path d="M4.5 5h5M4.5 7h5M4.5 9h3" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
        </svg>
      </span>
      <!-- content -->
      <div class="flex-1 min-w-0">
        <div class="text-ink font-medium" style="font-size: 13px; margin-bottom: 3px;">Auth middleware overview</div>
        <div class="text-ink-variant" style="font-size: 12px; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
          ...
          <mark style="background: rgba(245, 166, 35, 0.2); color: var(--tertiary); border-radius: 2px; padding: 0 2px;">session tokens</mark>
          are stored in the <code style="font-family: monospace; font-size: 11px; background: var(--surface-container-low); padding: 1px 4px; border-radius: 3px;">sessions</code> table with <code style="font-family: monospace; font-size: 11px; background: var(--surface-container-low); padding: 1px 4px; border-radius: 3px;">expires_at</code>...
        </div>
      </div>
      <!-- relevance -->
      <span class="font-mono text-ink-outline flex-shrink-0" style="font-size: 11px; margin-top: 3px;">0.92</span>
    </div>

    <!-- Result 2 — Decision -->
    <div class="flex items-start gap-3 px-4 py-3 cursor-pointer" style="border-bottom: 1px solid var(--ghost-border); transition: background 120ms;" onmouseenter="this.style.background='var(--surface-container-high)'" onmouseleave="this.style.background=''">
      <span class="flex items-center justify-center rounded-md flex-shrink-0" style="width: 28px; height: 28px; background: rgba(245, 166, 35, 0.12); margin-top: 1px;">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" style="color: var(--status-amber);">
          <rect x="2" y="2" width="10" height="10" rx="1.5" stroke="currentColor" stroke-width="1.2"/>
          <path d="M5 7l1.5 1.5L9 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <div class="flex-1 min-w-0">
        <div class="text-ink font-medium" style="font-size: 13px; margin-bottom: 3px;">Move session storage from cookie to Postgres</div>
        <div class="text-ink-outline" style="font-size: 12px;">implemented · 2026-04-08 · linked to 4 tasks</div>
      </div>
      <span class="font-mono text-ink-outline flex-shrink-0" style="font-size: 11px; margin-top: 3px;">0.88</span>
    </div>

    <!-- Result 3 — Task -->
    <div class="flex items-start gap-3 px-4 py-3 cursor-pointer" style="border-bottom: 1px solid var(--ghost-border); transition: background 120ms;" onmouseenter="this.style.background='var(--surface-container-high)'" onmouseleave="this.style.background=''">
      <span class="flex items-center justify-center rounded-md flex-shrink-0" style="width: 28px; height: 28px; background: rgba(59, 130, 246, 0.12); margin-top: 1px;">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" style="color: var(--status-blue);">
          <circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.2"/>
          <path d="M5 7l1.5 1.5L9 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <div class="flex-1 min-w-0">
        <div class="text-ink font-medium" style="font-size: 13px; margin-bottom: 3px;">
          <span class="font-mono text-ink-outline" style="font-size: 11px;">ENG-142</span>
          <span class="mx-1 text-ink-outline" style="font-size: 11px;">·</span>
          Replace cookie session with Postgres-backed sessions
        </div>
        <div class="text-ink-outline" style="font-size: 12px;">in_progress · @maneek · due 2026-04-22</div>
      </div>
      <span class="font-mono text-ink-outline flex-shrink-0" style="font-size: 11px; margin-top: 3px;">0.84</span>
    </div>

    <!-- Result 4 — Wiki page (older) -->
    <div class="flex items-start gap-3 px-4 py-3 cursor-pointer" style="transition: background 120ms;" onmouseenter="this.style.background='var(--surface-container-high)'" onmouseleave="this.style.background=''">
      <span class="flex items-center justify-center rounded-md flex-shrink-0" style="width: 28px; height: 28px; background: rgba(144, 128, 250, 0.08); margin-top: 1px;">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" style="color: var(--outline);">
          <rect x="2" y="1.5" width="10" height="11" rx="1.5" stroke="currentColor" stroke-width="1.2"/>
          <path d="M4.5 5h5M4.5 7h5M4.5 9h3" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
        </svg>
      </span>
      <div class="flex-1 min-w-0">
        <div class="text-ink font-medium" style="font-size: 13px; margin-bottom: 3px;">Cookie session limitations (legacy)</div>
        <div class="text-ink-outline" style="font-size: 12px;">last edited 8 weeks ago by Sara</div>
      </div>
      <span class="font-mono text-ink-outline flex-shrink-0" style="font-size: 11px; margin-top: 3px;">0.71</span>
    </div>

  </div>

  <!-- Footer -->
  <div class="flex items-center px-4" style="height: 28px; border-top: 1px solid var(--ghost-border); background: var(--surface-container-low);">
    <span style="font-size: 11px; color: var(--outline);">Keyword + meaning · blended ranking</span>
  </div>
</div>
