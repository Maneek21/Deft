---
type Props = {
  title: string;
  subtitle?: string;
  cta: { href: string; label: string };
};

const { title, subtitle, cta } = Astro.props;
---

<section
  class="relative overflow-hidden py-24"
  style="background: linear-gradient(180deg, var(--surface-container-low), var(--surface));"
>
  <!-- Subtle accent overlay -->
  <div
    class="pointer-events-none absolute inset-0"
    style="background: radial-gradient(ellipse at 50% 0%, var(--accent-muted) 0%, transparent 65%);"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto flex max-w-[1200px] flex-col items-center gap-6 px-6 text-center">
    <h2 class="section-title max-w-[640px]">{title}</h2>

    {subtitle && (
      <p class="lede max-w-[480px]">{subtitle}</p>
    )}

    <a
      href={cta.href}
      class="inline-flex h-10 items-center justify-center rounded-lg bg-primary-container px-6 text-sm font-semibold text-primary-on-container shadow-sm transition-opacity hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
    >
      {cta.label}
    </a>
  </div>
</section>
