---
// Theme toggle — mirrors apps/web's ThemeProvider behavior. Class on <html>
// toggles between `.dark` and `.light`. Persisted in localStorage. Bootstrap
// runs in <head> via inline script in Layout.astro to prevent FOUC.
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle theme"
  class="inline-flex h-8 w-8 items-center justify-center rounded-md text-ink-variant hover:bg-surface-container hover:text-ink"
>
  <svg class="hidden dark:block" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"/>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
  </svg>
  <svg class="block dark:hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
  </svg>
</button>

<script is:inline>
  (function () {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const isDark = root.classList.contains('dark');
      root.classList.toggle('dark', !isDark);
      root.classList.toggle('light', isDark);
      try {
        localStorage.setItem('deft-theme', isDark ? 'light' : 'dark');
      } catch {}
    });
  })();
</script>
