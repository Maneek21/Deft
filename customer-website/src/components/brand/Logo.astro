---
type Props = {
  variant?: 'wordmark' | 'icon';
  class?: string;
};

const { variant = 'wordmark', class: className = '' } = Astro.props;
---

{variant === 'icon' ? (
  <img src="/brand/deft-icon.png" alt="Deft" width="500" height="400" class={className} />
) : (
  <>
    <img src="/brand/deft-wordmark-on-light.png" alt="Deft" width="1000" height="400" class={`${className} block dark:hidden`} />
    <img src="/brand/deft-wordmark-on-dark.png" alt="Deft" width="1000" height="400" class={`${className} hidden dark:block`} />
  </>
)}
