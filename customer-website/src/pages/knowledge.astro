---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Card from '../components/Card.astro';
import CTABand from '../components/CTABand.astro';
import WikiSearchMock from '../components/mock/WikiSearchMock.astro';
import SurfaceFooter from '../components/SurfaceFooter.astro';
---

<Layout
  title="Deft — knowledge that compounds, not corrodes"
  description="Search by keyword and by meaning. Wiki pages, decisions, daily notes — all searchable in one place. Every AI answer cites the source it came from."
>

  <!-- ================================================================
       1. SUBPAGE HERO
       ================================================================ -->
  <div class="relative">
    <div class="hero-bloom" aria-hidden="true"></div>
    <div class="max-w-3xl mx-auto text-center pt-24 pb-16 relative px-6">
      <p class="eyebrow mb-4">Knowledge</p>
      <h1 class="display mb-6">Knowledge that compounds. Not corrodes.</h1>
      <p class="lede mx-auto max-w-[600px]">
        Wiki pages, decisions, daily notes, free notes — all searchable in one place.
        Search by keyword and by meaning. Every AI answer cites the source it came from.
      </p>
    </div>
  </div>

  <!-- ================================================================
       2. BIG VISUAL
       ================================================================ -->
  <div class="mx-auto max-w-3xl mt-4 mb-4 px-6 flex justify-center">
    <WikiSearchMock />
  </div>

  <!-- ================================================================
       3. HYBRID SEARCH
       ================================================================ -->
  <section id="hybrid" class="py-20 md:py-28">
    <div class="mx-auto max-w-[1200px] px-6">

      <SectionHeader
        eyebrow="01 · Hybrid search"
        title="Keyword and meaning. Same search bar."
        subtitle="Lexical match catches the words. Semantic match catches the meaning. Both are blended in one ranked list. If the AI provider is offline, keyword search still works — knowledge stays searchable even when AI is down."
      />

      <div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-2 lg:items-start">

        <!-- Left: Keyword card -->
        <Card variant="default">
          <div slot="header">
            <p class="text-[12px] font-mono text-ink-variant uppercase tracking-wide">Keyword</p>
          </div>
          <div class="flex flex-col gap-2">
            {[
              { title: 'Auth middleware overview', score: 'ranked' },
              { title: 'Cookie session limitations (legacy)', score: 'ranked' },
              { title: 'Move session storage from cookie to Postgres', score: 'ranked' },
            ].map((row) => (
              <div class="flex items-center justify-between gap-3 py-2" style="border-bottom: 1px solid var(--ghost-border);">
                <span class="text-ink-variant text-[13px] leading-snug">{row.title}</span>
                <span
                  class="font-mono text-[11px] rounded px-1.5 py-0.5 flex-shrink-0"
                  style="background: rgba(144,128,250,0.12); color: var(--primary);"
                >
                  {row.score}
                </span>
              </div>
            ))}
          </div>
          <div slot="footer">
            <p class="font-mono text-[11px] text-ink-outline">Lexical · keyword frequency</p>
          </div>
        </Card>

        <!-- Right: Meaning card -->
        <Card variant="default">
          <div slot="header">
            <p class="text-[12px] font-mono text-ink-variant uppercase tracking-wide">Meaning</p>
          </div>
          <div class="flex flex-col gap-2">
            {[
              { title: 'Move session storage from cookie to Postgres', score: 'ranked' },
              { title: 'Replace cookie session with Postgres-backed sessions', score: 'ranked' },
              { title: 'Auth middleware overview', score: 'ranked' },
            ].map((row) => (
              <div class="flex items-center justify-between gap-3 py-2" style="border-bottom: 1px solid var(--ghost-border);">
                <span class="text-ink-variant text-[13px] leading-snug">{row.title}</span>
                <span
                  class="font-mono text-[11px] rounded px-1.5 py-0.5 flex-shrink-0"
                  style="background: rgba(48,164,108,0.12); color: var(--status-green);"
                >
                  {row.score}
                </span>
              </div>
            ))}
          </div>
          <div slot="footer">
            <p class="font-mono text-[11px] text-ink-outline">Semantic · search by meaning</p>
          </div>
        </Card>

      </div>

      <!-- Merge arrow -->
      <div class="mt-6 flex flex-col items-center gap-3">
        <div class="flex items-center gap-3">
          <div class="h-px w-20 bg-ghost" style="background: var(--ghost-border);"></div>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" style="color: var(--primary);">
            <path d="M10 4v12M6 12l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <div class="h-px w-20" style="background: var(--ghost-border);"></div>
        </div>
        <Card variant="subtle" class="w-full max-w-sm">
          <div class="flex items-center justify-between gap-3">
            <span class="text-ink text-[13px] font-semibold">Ranked result list</span>
            <span class="font-mono text-[11px] text-ink-outline">Keyword + meaning · blended</span>
          </div>
          <div class="mt-3 flex flex-col gap-1.5 font-mono text-[12px] text-ink-variant">
            <div class="flex justify-between"><span>Auth middleware overview</span><span class="text-primary">0.92</span></div>
            <div class="flex justify-between"><span>Move session storage → Postgres</span><span class="text-primary">0.88</span></div>
            <div class="flex justify-between"><span>ENG-142 · Replace cookie session</span><span class="text-primary">0.84</span></div>
          </div>
        </Card>
      </div>

    </div>
  </section>

  <!-- ================================================================
       4. CITATIONS
       ================================================================ -->
  <section id="citations" class="py-20 md:py-28 bg-surface-container-low">
    <div class="mx-auto max-w-[1200px] px-6">
      <div class="grid grid-cols-1 gap-16 lg:grid-cols-2 lg:items-start">

        <!-- Left: copy -->
        <SectionHeader
          eyebrow="02 · Citations"
          title="Every AI answer cites its source."
          subtitle="Not 'I read your wiki.' The AI answers with the actual page, decision, or task it pulled from. You click through to the source. The audit log records which sources informed which answers."
        />

        <!-- Right: citation card -->
        <Card variant="subtle">
          <p class="text-[12px] font-semibold text-ink-variant mb-4 uppercase tracking-wide">Sources used in this answer</p>
          <div class="flex flex-col gap-4">

            <div class="flex flex-col gap-1" style="padding-bottom: 14px; border-bottom: 1px solid var(--ghost-border);">
              <span class="font-mono text-[12px] text-ink-variant">
                <span class="text-primary">from</span> {' '}
                <span class="text-primary">decisions.title</span>
              </span>
              <span class="text-[13px] text-ink leading-snug">'Move session storage from cookie to Postgres'</span>
              <span class="font-mono text-[11px] text-ink-outline">dec_8a2f · implemented 2026-04-21</span>
            </div>

            <div class="flex flex-col gap-1" style="padding-bottom: 14px; border-bottom: 1px solid var(--ghost-border);">
              <span class="font-mono text-[12px] text-ink-variant">
                <span class="text-primary">from</span> {' '}
                <span class="text-primary">wiki_pages.body</span>
              </span>
              <span class="text-[13px] text-ink leading-snug">'Auth middleware overview'</span>
              <span class="font-mono text-[11px] text-ink-outline">wiki_a4 · revision 14 · last edited by Sara</span>
            </div>

            <div class="flex flex-col gap-1">
              <span class="font-mono text-[12px] text-ink-variant">
                <span class="text-primary">from</span> {' '}
                <span class="text-primary">tasks.description</span>
              </span>
              <span class="text-[13px] text-ink leading-snug">'Replace cookie session with Postgres-backed sessions'</span>
              <span class="font-mono text-[11px] text-ink-outline">ENG-142 · in_progress · @maneek</span>
            </div>

          </div>
        </Card>

      </div>
    </div>
  </section>

  <!-- ================================================================
       5. DECISIONS LINKED TO WORK
       ================================================================ -->
  <section id="decisions" class="py-20 md:py-28">
    <div class="mx-auto max-w-[1200px] px-6">

      <SectionHeader
        eyebrow="03 · Decisions"
        title="Decisions linked to the tasks that implement them."
        subtitle="Link a decision to the tasks that follow from it. When the last task closes, the decision is marked implemented automatically. No more 'why did we do this?' six months later."
      />

      <div class="mt-12">
        <Card variant="default">

          <!-- Decision header -->
          <div class="flex items-start justify-between gap-4 mb-1">
            <span class="text-[16px] font-semibold text-ink leading-snug">
              Move session storage from cookie to Postgres
            </span>
            <span
              class="flex-shrink-0 font-mono text-[11px] rounded-md px-2 py-0.5 font-semibold"
              style="background: rgba(48,164,108,0.15); color: var(--status-green);"
            >
              implemented
            </span>
          </div>
          <p class="text-[13px] text-ink-variant mb-5">
            Decided 2026-04-08 by @Sara · Implemented 2026-04-21
          </p>

          <!-- Linked tasks -->
          <div class="flex flex-col gap-2" style="border-top: 1px solid var(--ghost-border); padding-top: 16px;">
            <p class="text-[12px] font-semibold text-ink-variant uppercase tracking-wide mb-1">Linked tasks</p>

            {[
              { id: 'ENG-141', title: 'Add hmac_key_encrypted column', status: 'done', statusColor: 'var(--status-green)', assignee: 'MM' },
              { id: 'ENG-142', title: 'Replace cookie session with Postgres-backed sessions', status: 'done', statusColor: 'var(--status-green)', assignee: 'MM' },
              { id: 'ENG-143', title: 'Update middleware to read sessions from Postgres', status: 'done', statusColor: 'var(--status-green)', assignee: 'MM' },
              { id: 'ENG-144', title: 'Deprecate cookie session after Acme demo window', status: 'in_review', statusColor: 'var(--status-blue)', assignee: 'SA' },
            ].map((task) => (
              <div class="flex items-center gap-3 py-2.5" style="border-bottom: 1px solid var(--ghost-border);">
                <span class="font-mono text-[11px] text-ink-outline w-16 flex-shrink-0">{task.id}</span>
                <span class="flex-1 text-[13px] text-ink truncate">{task.title}</span>
                <span
                  class="font-mono text-[11px] rounded px-1.5 py-0.5 flex-shrink-0"
                  style={`background: ${task.statusColor}22; color: ${task.statusColor};`}
                >
                  {task.status}
                </span>
                <span
                  class="flex items-center justify-center rounded-full font-semibold text-[10px] flex-shrink-0"
                  style="width: 22px; height: 22px; background: var(--surface-container-high); color: var(--on-surface-variant);"
                >
                  {task.assignee}
                </span>
              </div>
            ))}

          </div>

          <div slot="footer">
            <a
              href="#"
              class="text-[13px] font-medium text-primary hover:opacity-80 transition-opacity"
            >
              View source decision →
            </a>
          </div>

        </Card>
      </div>

    </div>
  </section>

  <!-- ================================================================
       6. CROSS-REFERENCE GRAPH
       ================================================================ -->
  <section id="graph" class="py-20 md:py-28 bg-surface-container-low">
    <div class="mx-auto max-w-[1200px] px-6">
      <div class="grid grid-cols-1 gap-16 lg:grid-cols-2 lg:items-center">

        <!-- Left: mini graph -->
        <Card variant="default">
          <p class="text-[12px] font-semibold text-ink-variant uppercase tracking-wide mb-4">Two-way links</p>
          <div class="flex justify-center py-4">
            <svg
              width="260"
              height="180"
              viewBox="0 0 260 180"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-label="Cross-reference graph: Wiki, Decision, Task, Chat nodes"
            >
              <!-- Edges -->
              <line x1="130" y1="34" x2="50" y2="130" stroke="var(--ghost-border)" stroke-width="1.5"/>
              <line x1="130" y1="34" x2="210" y2="130" stroke="var(--ghost-border)" stroke-width="1.5"/>
              <line x1="50" y1="130" x2="210" y2="130" stroke="var(--ghost-border)" stroke-width="1.5"/>
              <line x1="130" y1="34" x2="130" y2="146" stroke="var(--ghost-border)" stroke-width="1.5" stroke-dasharray="4 3"/>
              <!-- Nodes -->
              <circle cx="130" cy="34" r="10" fill="rgba(144,128,250,0.2)" stroke="var(--primary)" stroke-width="1.5"/>
              <circle cx="50" cy="130" r="10" fill="rgba(245,166,35,0.18)" stroke="var(--status-amber)" stroke-width="1.5"/>
              <circle cx="210" cy="130" r="10" fill="rgba(59,130,246,0.18)" stroke="var(--status-blue)" stroke-width="1.5"/>
              <circle cx="130" cy="146" r="10" fill="rgba(48,164,108,0.18)" stroke="var(--status-green)" stroke-width="1.5"/>
              <!-- Labels -->
              <text x="130" y="18" text-anchor="middle" font-size="11" font-family="var(--font-mono, monospace)" fill="var(--primary)">Wiki</text>
              <text x="30" y="154" text-anchor="middle" font-size="11" font-family="var(--font-mono, monospace)" fill="var(--status-amber)">Decision</text>
              <text x="210" y="154" text-anchor="middle" font-size="11" font-family="var(--font-mono, monospace)" fill="var(--status-blue)">Task</text>
              <text x="130" y="170" text-anchor="middle" font-size="11" font-family="var(--font-mono, monospace)" fill="var(--status-green)">Chat</text>
            </svg>
          </div>
          <p class="text-[12px] text-ink-outline text-center mt-1 font-mono">Every link is two-way. Every link is auditable.</p>
        </Card>

        <!-- Right: copy -->
        <SectionHeader
          eyebrow="04 · Connections"
          title="Wiki ↔ decisions ↔ tasks ↔ chat."
          subtitle="Every link is a two-way connection. Promote a note to a wiki page and the source is preserved. Implement a decision and the linked tasks know about it. Every connection is searchable, every connection is auditable."
        />

      </div>
    </div>
  </section>

  <!-- ================================================================
       7. DAILY NOTES ARE KNOWLEDGE TOO
       ================================================================ -->
  <section id="daily" class="py-20 md:py-28">
    <div class="mx-auto max-w-[1200px] px-6">
      <SectionHeader
        eyebrow="Knowledge corpus"
        title="Daily notes, free notes, decisions — all in the same search index."
        subtitle="The AI doesn't know the difference between surface types when it searches. A daily note from last quarter, a decision from the kickoff, a wiki page from onboarding — they're all searchable in one place."
        align="center"
      />

      <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6 max-w-3xl mx-auto">

        <Card variant="subtle">
          <p class="text-[13px] font-semibold text-ink mb-1">Daily notes</p>
          <p class="text-[13px] text-ink-variant leading-relaxed">
            Structured by date. Fully indexed. The AI can answer
            "what was happening during the migration sprint" from raw daily entries.
          </p>
        </Card>

        <Card variant="subtle">
          <p class="text-[13px] font-semibold text-ink mb-1">Free notes</p>
          <p class="text-[13px] text-ink-variant leading-relaxed">
            Unstructured, user-authored. Searchable by keyword and meaning.
            Any note can be promoted to a wiki page with a stable, permanent link.
          </p>
        </Card>

        <Card variant="subtle">
          <p class="text-[13px] font-semibold text-ink mb-1">Decisions</p>
          <p class="text-[13px] text-ink-variant leading-relaxed">
            First-class primitives with status, author, linked tasks, and an
            implementation timestamp. Not just notes with a label.
          </p>
        </Card>

      </div>
    </div>
  </section>

  <!-- ================================================================
       8. SURFACE FOOTER + CTA BAND
       ================================================================ -->
  <SurfaceFooter current="knowledge" />

  <CTABand
    title="Stop losing knowledge in chat threads."
    cta={{ href: '/pricing#waitlist', label: 'Join the waitlist' }}
  />

</Layout>
