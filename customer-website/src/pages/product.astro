---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Card from '../components/Card.astro';
import BentoGrid from '../components/BentoGrid.astro';
import BentoItem from '../components/BentoItem.astro';
import CTABand from '../components/CTABand.astro';
import PlanProposalMock from '../components/mock/PlanProposalMock.astro';
---

<Layout
  title="Deft — how the workspace and the agent share one source of truth"
  description="Direct SQL context, three-tier approval rails, agents as teammates. The architecture behind the AI-native workspace."
>

  <!-- ================================================================
       1. SUBPAGE HERO
       ================================================================ -->
  <div class="relative">
    <div class="hero-bloom" aria-hidden="true"></div>
    <div class="max-w-3xl mx-auto text-center pt-24 pb-16 relative px-6">
      <p class="eyebrow mb-4">Product</p>
      <h1 class="display">One workspace. One database. Both humans and agents read from it.</h1>
      <p class="lede mt-6 mx-auto max-w-[600px]">
        The agent doesn't reconstruct your team from API calls and pasted summaries.
        It queries the same tables your dashboard does.
      </p>
    </div>
  </div>

  <!-- ================================================================
       2. NATIVE DATA LAYER
       ================================================================ -->
  <section class="py-20 md:py-28">
    <div class="mx-auto max-w-[1200px] px-6">
      <SectionHeader
        eyebrow="01 · Native data"
        title="Direct SQL beats reconstructed context."
        subtitle="Every event in the system — a Slack message, a calendar invite, a GitHub PR, a chat message in Deft — is normalized into a unified events table. The agent joins across them in real time."
      />

      <div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-2 lg:items-start">

        <!-- Left: SQL example -->
        <Card variant="default">
          <div slot="header">
            <p class="text-[13px] font-mono text-ink-variant">agent context query — tasks + github events</p>
          </div>
          <pre class="font-mono text-[13px] leading-relaxed overflow-x-auto whitespace-pre"><code><span class="text-primary">SELECT</span> t.id, t.title, t.priority, e.payload-&gt;&gt;<span class="text-[color:var(--status-green)]">'pr_number'</span> <span class="text-primary">AS</span> pr
<span class="text-primary">FROM</span>   tasks t
<span class="text-primary">LEFT JOIN</span> events e
  <span class="text-primary">ON</span>  e.task_id = t.id
  <span class="text-primary">AND</span> e.kind = <span class="text-[color:var(--status-green)]">'github.pr_opened'</span>
<span class="text-primary">WHERE</span>  t.org_id = $1
  <span class="text-primary">AND</span>  t.status <span class="text-primary">IN</span> (<span class="text-[color:var(--status-green)]">'todo'</span>, <span class="text-[color:var(--status-green)]">'in_progress'</span>, <span class="text-[color:var(--status-green)]">'in_review'</span>)
  <span class="text-primary">AND</span>  t.assignee_id = $2
<span class="text-primary">ORDER BY</span> t.priority <span class="text-primary">ASC</span>, t.updated_at <span class="text-primary">DESC</span>;</code></pre>
        </Card>

        <!-- Right: data source cards -->
        <div class="flex flex-col gap-4">
          <Card variant="subtle">
            <p class="text-[13px] font-semibold text-ink mb-1">Native data</p>
            <p class="text-[13px] text-ink-variant">
              Chat messages, tasks, decisions, notes, wiki pages, and daily notes —
              all in Postgres, all readable by the agent via direct SQL.
            </p>
          </Card>

          <Card variant="subtle">
            <p class="text-[13px] font-semibold text-ink mb-1">Connected events</p>
            <p class="text-[13px] text-ink-variant">
              GitHub, Slack, Google Calendar, Gmail, and Linear activity is normalized
              into the unified <code class="font-mono text-[12px] text-primary">events</code> table.
              The agent joins across native and external data in one query.
            </p>
          </Card>

          <Card variant="subtle">
            <p class="text-[13px] font-semibold text-ink mb-1">Approval rails</p>
            <p class="text-[13px] text-ink-variant">
              Every external write passes through the audit log. The agent never
              acts without a recorded <code class="font-mono text-[12px] text-primary">agent_actions</code> row — reads or writes.
            </p>
          </Card>
        </div>

      </div>
    </div>
  </section>

  <!-- ================================================================
       3. THREE-TIER APPROVALS
       ================================================================ -->
  <section class="py-20 md:py-28 bg-surface-container-low">
    <div class="mx-auto max-w-[1200px] px-6">
      <SectionHeader
        eyebrow="02 · Approval rails"
        title="Three tiers. The team picks which the agent gets."
      />

      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">

        <!-- Auto-execute -->
        <Card variant="default">
          <div class="flex items-center gap-2 mb-4">
            <span class="inline-block h-2.5 w-2.5 rounded-full bg-[color:var(--status-green)]"></span>
            <p class="text-[13px] font-semibold text-ink uppercase tracking-wide font-mono">Auto-execute</p>
          </div>
          <p class="text-[15px] font-semibold text-ink mb-2">
            PR merged → task done. No prompt, no friction.
          </p>
          <p class="text-[13px] text-ink-variant leading-relaxed">
            Reminder fired. Standup posted. Status transitions from merged PRs.
            Reads-only by default at Conservative trust. Auto-execute actions never
            touch external writes unless the org explicitly opts in.
          </p>
        </Card>

        <!-- Quick-approve -->
        <Card variant="default">
          <div class="flex items-center gap-2 mb-4">
            <span class="inline-block h-2.5 w-2.5 rounded-full bg-[color:var(--status-amber)]"></span>
            <p class="text-[13px] font-semibold text-ink uppercase tracking-wide font-mono">Quick-approve</p>
          </div>
          <p class="text-[15px] font-semibold text-ink mb-2">
            Create task. Schedule meeting. Post a draft.
          </p>
          <p class="text-[13px] text-ink-variant leading-relaxed">
            A one-tap card surfaces in the Inbox. The agent waits for the team member
            to approve before writing anything. Standard trust unlocks this tier — the
            default for most teams.
          </p>
        </Card>

        <!-- Full-review -->
        <Card variant="default">
          <div class="flex items-center gap-2 mb-4">
            <span class="inline-block h-2.5 w-2.5 rounded-full bg-[color:var(--status-red)]"></span>
            <p class="text-[13px] font-semibold text-ink uppercase tracking-wide font-mono">Full-review</p>
          </div>
          <p class="text-[15px] font-semibold text-ink mb-2">
            Multi-step plans, email drafts, external writes.
          </p>
          <p class="text-[13px] text-ink-variant leading-relaxed">
            Plan visible and editable before anything runs. Full audit trail on execute.
            Destructive admin tools — <code class="font-mono text-[12px] text-primary">remove_member</code>, <code class="font-mono text-[12px] text-primary">delete_*</code> — never auto-execute,
            even at Autonomous trust.
          </p>
        </Card>

      </div>
    </div>
  </section>

  <!-- ================================================================
       4. PLAN WITH RECEIPTS
       ================================================================ -->
  <section class="py-20 md:py-28">
    <div class="mx-auto max-w-[1200px] px-6">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-center">

        <!-- Left: copy -->
        <div>
          <SectionHeader
            eyebrow="03 · Receipts, not vibes"
            title="Every step shows its work."
            subtitle="When the agent proposes a plan, you see what it queried, what it'll change, and which task IDs are affected. Reject, edit, or approve. Then the agent runs and the audit log updates in real time."
          />
        </div>

        <!-- Right: mock -->
        <div class="flex justify-center">
          <PlanProposalMock
            avatar="D"
            title="Defty proposed a plan"
            subtitle="in #launch-q2 · 2m ago"
            steps={[
              { status: 'done', label: 'Queried open tasks assigned to Maneek', detail: [
                { text: "SELECT t.id, t.title FROM tasks t WHERE org_id = $1" },
                { text: "  AND assignee_id = $2 AND status != 'done'" },
                { text: "→ ENG-142, ENG-143, ENG-156", color: 'green' }
              ]},
              { status: 'done', label: 'Fetched related Acme events from calendar', detail: [
                { text: "SELECT e.payload FROM events e" },
                { text: "  JOIN tasks t ON e.task_id = t.id WHERE t.org_id = $1" },
                { text: "→ 14 rows · 22ms", color: 'green' }
              ]},
              { status: 'in_progress', label: 'Generating executive briefing…', detail: [
                { text: "Composing summary from 3 tasks + 14 event rows" },
                { text: "→ running", color: 'amber' }
              ]},
              { status: 'pending', label: 'Post briefing to #launch-q2', detail: [
                { text: "external · awaiting step 3", color: 'blue' }
              ]}
            ]}
            primaryAction="Approve full plan"
          />
        </div>

      </div>
    </div>
  </section>

  <!-- ================================================================
       5. RELIABILITY STORY
       ================================================================ -->
  <section class="py-20 md:py-28 bg-surface-container-low">
    <div class="mx-auto max-w-[1200px] px-6">
      <SectionHeader
        eyebrow="04 · Reliable without AI"
        title="Pull the model out. The workspace still works."
        subtitle="Chat sends messages. Kanban moves cards. Standups still post (with a one-time admin notification when no agent is configured to write them). Deft is a workspace that happens to have an agent — not an agent with a UI."
        align="center"
      />

      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3 max-w-3xl mx-auto">
        <Card variant="subtle">
          <p class="text-[13px] font-semibold text-ink mb-1">Chat still works</p>
          <p class="text-[13px] text-ink-variant">Messages send. Threads reply. Pins pin. The real-time layer doesn't depend on any LLM.</p>
        </Card>
        <Card variant="subtle">
          <p class="text-[13px] font-semibold text-ink mb-1">Tasks still move</p>
          <p class="text-[13px] text-ink-variant">Kanban, list, timeline, and calendar views work. Status, assignee, priority — all editable without an agent online.</p>
        </Card>
        <Card variant="subtle">
          <p class="text-[13px] font-semibold text-ink mb-1">Standups still surface</p>
          <p class="text-[13px] text-ink-variant">If no BYOA agent is subscribed to <code class="font-mono text-[12px] text-primary">cron:standup</code>, admins get a single notification pointing at the agent library. No silent failure.</p>
        </Card>
      </div>
    </div>
  </section>

  <!-- ================================================================
       6. SIX OPERATING LAYERS
       ================================================================ -->
  <section class="py-20 md:py-28">
    <div class="mx-auto max-w-[1200px] px-6">
      <SectionHeader
        eyebrow="05 · Operating model"
        title="Six layers, end to end."
      />

      <div class="mt-12">
        <BentoGrid>

          <BentoItem span={4}>
            <p class="eyebrow font-mono mb-2">Conversation</p>
            <p class="font-semibold text-ink mb-2">Chat is the observation surface.</p>
            <p class="text-[14px] text-ink-variant leading-relaxed">
              Every message is classified for actionability, intent, entities, and urgency.
              Defty surfaces inline task-suggestion cards for actionable messages without
              being asked.
            </p>
          </BentoItem>

          <BentoItem span={4}>
            <p class="eyebrow font-mono mb-2">Execution</p>
            <p class="font-semibold text-ink mb-2">Tasks are the action surface.</p>
            <p class="text-[14px] text-ink-variant leading-relaxed">
              Native CRUD plus connected writes through approval rails. Every
              external write — Slack message, calendar invite, GitHub issue — goes through
              the same three-tier gate before it leaves the workspace.
            </p>
          </BentoItem>

          <BentoItem span={4}>
            <p class="eyebrow font-mono mb-2">Memory</p>
            <p class="font-semibold text-ink mb-2">Wiki, notes, decisions. All queryable.</p>
            <p class="text-[14px] text-ink-variant leading-relaxed">
              Semantic search blends FTS and pgvector cosine similarity (0.4 / 0.6 weight
              by confidence). The agent retrieves from the same Postgres tables your
              dashboard reads.
            </p>
          </BentoItem>

          <BentoItem span={4}>
            <p class="eyebrow font-mono mb-2">Agency</p>
            <p class="font-semibold text-ink mb-2">Heartbeat ticks, trigger subscriptions, and skills.</p>
            <p class="text-[14px] text-ink-variant leading-relaxed">
              BYOA agents pull pending work via <code class="font-mono text-[12px] text-primary">poll_pending_work</code>. Mentions, heartbeat ticks,
              webhook triggers, and skill crons all queue <code class="font-mono text-[12px] text-primary">agent_actions</code> rows for MCP pickup.
            </p>
          </BentoItem>

          <BentoItem span={4}>
            <p class="eyebrow font-mono mb-2">Reliability</p>
            <p class="font-semibold text-ink mb-2">Per-org spend caps. Circuit breakers.</p>
            <p class="text-[14px] text-ink-variant leading-relaxed">
              Daily budgets per BYOA employee (default $100/day). Circuit breaker trips
              after three consecutive errors, blocking dispatch until manually cleared.
              Loop detection skips re-dispatch when nothing changed since the last no-op tick.
            </p>
          </BentoItem>

          <BentoItem span={4}>
            <p class="eyebrow font-mono mb-2">Ownership</p>
            <p class="font-semibold text-ink mb-2">Your data, your runtime, your model keys.</p>
            <p class="text-[14px] text-ink-variant leading-relaxed">
              BSL 1.1. Mandatory attribution in forks. Self-host on Docker Compose.
              Bring your own Anthropic API key. The model is yours to swap — no vendor
              lock-in at the runtime layer.
            </p>
          </BentoItem>

        </BentoGrid>
      </div>
    </div>
  </section>

  <!-- ================================================================
       7. CTA BAND
       ================================================================ -->
  <CTABand
    title="Ready to see it in your workspace?"
    cta={{ href: '/pricing#waitlist', label: 'Join the waitlist' }}
  />

</Layout>
