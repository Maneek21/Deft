---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Card from '../components/Card.astro';
import CTABand from '../components/CTABand.astro';
import CrossRefMock from '../components/mock/CrossRefMock.astro';
import SQLDiffMock from '../components/mock/SQLDiffMock.astro';
import LiveLedgerMock from '../components/mock/LiveLedgerMock.astro';
---

<Layout
  title="Deft — chat, tasks, notes, knowledge, calendar, dashboard"
  description="One workspace. Six surfaces. The AI reads them all. How chat, tasks, notes, decisions, calendar, and dashboard work together as the AI-native workspace."
>

  <!-- ================================================================
       1. HERO
       ================================================================ -->
  <div class="relative">
    <div class="hero-bloom" aria-hidden="true"></div>
    <div class="max-w-3xl mx-auto text-center pt-24 pb-16 relative px-6">
      <p class="eyebrow mb-4">The workspace</p>
      <h1 class="display">One workspace. Six surfaces. One source of truth.</h1>
      <p class="lede mt-6 mx-auto max-w-[620px]">
        Chat where intent shows up. Tasks where it ships. Notes where it stays. Knowledge where it
        compounds. Calendar where time goes. Dashboard where it all lands. The AI follows every
        surface — no copy-paste required.
      </p>
    </div>
  </div>

  <!-- ================================================================
       1.5 LIVE LEDGER — animated proof of "one source of truth"
       ================================================================ -->
  <section class="pb-20 md:pb-28">
    <div class="max-w-[1200px] mx-auto px-6">
      <LiveLedgerMock />
    </div>
  </section>

  <!-- ================================================================
       2. THE THREAD OF WORK
       ================================================================ -->
  <section class="py-20 md:py-28" id="thread">
    <div class="max-w-[1200px] mx-auto px-6">
      <SectionHeader
        eyebrow="How it connects"
        title="A single thread of work, end to end."
        subtitle="Every surface lives in the same source of truth. Mentions, links, and a unified activity timeline tie them together. The AI follows the thread without losing context."
        align="center"
      />

      <div class="flex justify-center mt-12">
        <CrossRefMock class="max-w-5xl w-full" />
      </div>

      <!-- 3-col flow explanation -->
      <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">

        <div class="flex flex-col gap-2">
          <p class="text-[13px] font-semibold text-ink">Chat → Task</p>
          <p class="text-[13px] text-ink-variant leading-relaxed">
            @-mention an actionable message; one tap promotes it to a task. The original message stays linked.
          </p>
        </div>

        <div class="flex flex-col gap-2">
          <p class="text-[13px] font-semibold text-ink">Task → Decision</p>
          <p class="text-[13px] text-ink-variant leading-relaxed">
            When a task captures a non-trivial choice, mark it a decision. When the work ships, the decision is marked implemented automatically.
          </p>
        </div>

        <div class="flex flex-col gap-2">
          <p class="text-[13px] font-semibold text-ink">Decision → Wiki</p>
          <p class="text-[13px] text-ink-variant leading-relaxed">
            Decisions can become versioned wiki pages. Searchable by keyword and by meaning. Cited on every AI answer.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- ================================================================
       3. SIX SURFACES
       ================================================================ -->
  <section class="py-20 md:py-28 bg-surface-container-low" id="surfaces">
    <div class="max-w-[1200px] mx-auto px-6">
      <SectionHeader
        eyebrow="Six surfaces"
        title="Each surface, end to end."
        align="center"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-12">

        <!-- Chat -->
        <a href="/chat" class="block">
          <Card lift class="h-full flex flex-col gap-4">
            <div class="flex items-center gap-3">
              <!-- chat icon -->
              <span class="flex items-center justify-center rounded-md flex-shrink-0" style="width: 28px; height: 28px; background: rgba(144, 128, 250, 0.15);">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" style="color: var(--primary);">
                  <path d="M2 3a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1H6.5l-2.5 2V10H3a1 1 0 0 1-1-1V3Z" stroke="currentColor" stroke-width="1.2"/>
                </svg>
              </span>
              <p class="eyebrow">Chat</p>
            </div>
            <p class="text-[14px] text-ink-variant leading-relaxed flex-1">
              Spaces, threads, and mentions — plus a fast classifier on every message so the
              AI knows what's actionable before you have to say it.
            </p>
            <div class="font-mono text-[12px] text-ink-outline bg-surface-container rounded-md px-3 py-2">
              @deft summarize what we promised acme
            </div>
          </Card>
        </a>

        <!-- Tasks -->
        <a href="/tasks" class="block">
          <Card lift class="h-full flex flex-col gap-4">
            <div class="flex items-center gap-3">
              <!-- kanban icon -->
              <span class="flex items-center justify-center rounded-md flex-shrink-0" style="width: 28px; height: 28px; background: rgba(59, 130, 246, 0.12);">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" style="color: var(--status-blue);">
                  <rect x="1.5" y="2" width="3" height="10" rx="1" stroke="currentColor" stroke-width="1.2"/>
                  <rect x="5.5" y="2" width="3" height="7" rx="1" stroke="currentColor" stroke-width="1.2"/>
                  <rect x="9.5" y="2" width="3" height="5" rx="1" stroke="currentColor" stroke-width="1.2"/>
                </svg>
              </span>
              <p class="eyebrow">Tasks</p>
            </div>
            <p class="text-[14px] text-ink-variant leading-relaxed flex-1">
              Board, list, timeline, calendar, and pipeline views. Every project shares the
              same six-status vocabulary — no per-project configuration needed.
            </p>
            <div class="font-mono text-[12px] text-ink-outline bg-surface-container rounded-md px-3 py-2">
              ENG-142 · in progress
            </div>
          </Card>
        </a>

        <!-- Notes -->
        <a href="/notes" class="block">
          <Card lift class="h-full flex flex-col gap-4">
            <div class="flex items-center gap-3">
              <!-- page icon -->
              <span class="flex items-center justify-center rounded-md flex-shrink-0" style="width: 28px; height: 28px; background: rgba(245, 166, 35, 0.12);">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" style="color: var(--status-amber);">
                  <rect x="2" y="1.5" width="10" height="11" rx="1.5" stroke="currentColor" stroke-width="1.2"/>
                  <path d="M4.5 5h5M4.5 7.5h5M4.5 10h3" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
                </svg>
              </span>
              <p class="eyebrow">Notes</p>
            </div>
            <p class="text-[14px] text-ink-variant leading-relaxed flex-1">
              Personal and daily notes with a rich editor. Readable by the AI, promotable to
              wiki pages, and linked to tasks and decisions through the same connection layer.
            </p>
            <div class="font-mono text-[12px] text-ink-outline bg-surface-container rounded-md px-3 py-2">
              Auth migration sync — 2026-04-21
            </div>
          </Card>
        </a>

        <!-- Knowledge -->
        <a href="/knowledge" class="block">
          <Card lift class="h-full flex flex-col gap-4">
            <div class="flex items-center gap-3">
              <!-- book icon -->
              <span class="flex items-center justify-center rounded-md flex-shrink-0" style="width: 28px; height: 28px; background: rgba(48, 164, 108, 0.12);">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" style="color: var(--status-green);">
                  <path d="M7 2.5C7 2.5 5 1.5 2.5 2.5v9C5 10.5 7 11.5 7 11.5M7 2.5C7 2.5 9 1.5 11.5 2.5v9C9 10.5 7 11.5 7 11.5M7 2.5v9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                </svg>
              </span>
              <p class="eyebrow">Knowledge</p>
            </div>
            <p class="text-[14px] text-ink-variant leading-relaxed flex-1">
              Wiki pages, decisions, and daily notes in one searchable layer. Search by keyword
              and by meaning, blended in one bar. The AI cites the source — not a summary.
            </p>
            <div class="font-mono text-[12px] text-ink-outline bg-surface-container rounded-md px-3 py-2">
              Wiki · Decisions · Daily notes — searchable in one place
            </div>
          </Card>
        </a>

        <!-- Calendar -->
        <a href="/calendar" class="block">
          <Card lift class="h-full flex flex-col gap-4">
            <div class="flex items-center gap-3">
              <!-- calendar icon -->
              <span class="flex items-center justify-center rounded-md flex-shrink-0" style="width: 28px; height: 28px; background: rgba(229, 72, 77, 0.1);">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" style="color: var(--status-red);">
                  <rect x="1.5" y="2.5" width="11" height="10" rx="1.5" stroke="currentColor" stroke-width="1.2"/>
                  <path d="M1.5 5.5h11M4.5 1.5v2M9.5 1.5v2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                </svg>
              </span>
              <p class="eyebrow">Calendar</p>
            </div>
            <p class="text-[14px] text-ink-variant leading-relaxed flex-1">
              Google Calendar events synced into a single timeline. The AI can see your calendar
              alongside your tasks and decisions — in one place, without a separate lookup.
            </p>
            <div class="font-mono text-[12px] text-ink-outline bg-surface-container rounded-md px-3 py-2">
              Today · 9:00 standup, 2:00 demo, 4:00 review
            </div>
          </Card>
        </a>

        <!-- Dashboard -->
        <a href="/dashboard" class="block">
          <Card lift class="h-full flex flex-col gap-4">
            <div class="flex items-center gap-3">
              <!-- grid icon -->
              <span class="flex items-center justify-center rounded-md flex-shrink-0" style="width: 28px; height: 28px; background: rgba(144, 128, 250, 0.1);">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" style="color: var(--primary);">
                  <rect x="1.5" y="1.5" width="4.5" height="4.5" rx="1" stroke="currentColor" stroke-width="1.2"/>
                  <rect x="8" y="1.5" width="4.5" height="4.5" rx="1" stroke="currentColor" stroke-width="1.2"/>
                  <rect x="1.5" y="8" width="4.5" height="4.5" rx="1" stroke="currentColor" stroke-width="1.2"/>
                  <rect x="8" y="8" width="4.5" height="4.5" rx="1" stroke="currentColor" stroke-width="1.2"/>
                </svg>
              </span>
              <p class="eyebrow">Dashboard</p>
            </div>
            <p class="text-[14px] text-ink-variant leading-relaxed flex-1">
              My Work, Agent Activity, Briefing, and Focus tiles. The daily briefing is
              generated from completed tasks, merged PRs, and blocked items — not a
              manually curated widget.
            </p>
            <div class="font-mono text-[12px] text-ink-outline bg-surface-container rounded-md px-3 py-2">
              My Work · Agent Activity · Briefing · Focus
            </div>
          </Card>
        </a>

      </div>
    </div>
  </section>

  <!-- ================================================================
       4. ONE SOURCE OF TRUTH
       ================================================================ -->
  <section class="py-20 md:py-28" id="database">
    <div class="max-w-[1200px] mx-auto px-6">
      <SectionHeader
        eyebrow="One source of truth"
        title="What you see is what the AI sees."
        subtitle="The dashboard, the search, the agent — all reading the same data. No 'AI brain' that lags behind your real work."
        align="center"
      />

      <div class="flex justify-center mt-12">
        <SQLDiffMock class="max-w-5xl w-full" />
      </div>
    </div>
  </section>

  <!-- ================================================================
       5. WHAT IT ADDS UP TO
       ================================================================ -->
  <section class="py-20 md:py-28 bg-surface-container-low" id="payoff">
    <div class="max-w-[1200px] mx-auto px-6">
      <SectionHeader
        eyebrow="What changes"
        title="Five things that only happen when surfaces share one source of truth."
        align="center"
      />

      <div class="flex flex-col gap-4 mt-12">

        <Card variant="subtle">
          <div class="flex items-start gap-6">
            <span class="font-mono text-[13px] text-primary font-semibold flex-shrink-0 mt-0.5">01</span>
            <div>
              <p class="text-[15px] font-semibold text-ink mb-1">A chat thread becomes a task without copy-paste.</p>
              <p class="text-[14px] text-ink-variant leading-relaxed">
                @-mention the AI with the ask; it proposes a task pre-populated with the chat
                context. One tap to accept. The chat message stays linked.
              </p>
            </div>
          </div>
        </Card>

        <Card variant="subtle">
          <div class="flex items-start gap-6">
            <span class="font-mono text-[13px] text-primary font-semibold flex-shrink-0 mt-0.5">02</span>
            <div>
              <p class="text-[15px] font-semibold text-ink mb-1">A task closes the moment its PR lands.</p>
              <p class="text-[14px] text-ink-variant leading-relaxed">
                When the engineer merges a pull request that mentions a task, the task moves to done. The activity log shows the link automatically.
              </p>
            </div>
          </div>
        </Card>

        <Card variant="subtle">
          <div class="flex items-start gap-6">
            <span class="font-mono text-[13px] text-primary font-semibold flex-shrink-0 mt-0.5">03</span>
            <div>
              <p class="text-[15px] font-semibold text-ink mb-1">A decision links to every task that implements it.</p>
              <p class="text-[14px] text-ink-variant leading-relaxed">
                Mark a decision; link the implementing tasks. When the last task ships, the decision is marked implemented. No more "why did we do this?" six months later.
              </p>
            </div>
          </div>
        </Card>

        <Card variant="subtle">
          <div class="flex items-start gap-6">
            <span class="font-mono text-[13px] text-primary font-semibold flex-shrink-0 mt-0.5">04</span>
            <div>
              <p class="text-[15px] font-semibold text-ink mb-1">The AI answers with sources, not vibes.</p>
              <p class="text-[14px] text-ink-variant leading-relaxed">
                Every answer cites the page, decision, or task it came from. You click through to the source. No black-box generation.
              </p>
            </div>
          </div>
        </Card>

        <Card variant="subtle">
          <div class="flex items-start gap-6">
            <span class="font-mono text-[13px] text-primary font-semibold flex-shrink-0 mt-0.5">05</span>
            <div>
              <p class="text-[15px] font-semibold text-ink mb-1">Daily standups write themselves.</p>
              <p class="text-[14px] text-ink-variant leading-relaxed">
                The AI pulls yesterday's closed tasks, merged PRs, and blocked items into a focused standup. Posted at 9 AM. Edit before send if you want.
              </p>
            </div>
          </div>
        </Card>

      </div>
    </div>
  </section>

  <!-- ================================================================
       6. ARCHITECTURE DEEP DIVE CALLOUT
       ================================================================ -->
  <section class="py-16" id="architecture">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="bg-surface-container-low rounded-lg p-12 my-16">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">

          <!-- Left copy -->
          <div>
            <p class="text-[17px] font-semibold text-ink mb-5">
              Want to see how it's wired underneath?
            </p>
            <ul class="flex flex-col gap-3">
              {[
                'Native source-of-truth design',
                'Three-tier approval rails',
                'Six operating layers',
                'Open source under BSL 1.1 · self-hostable',
              ].map((item) => (
                <li class="flex items-center gap-2.5">
                  <span class="flex-shrink-0 rounded-full" style="width: 6px; height: 6px; background: var(--primary);"></span>
                  <span class="text-[14px] text-ink-variant">{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Right CTA -->
          <div class="flex items-center lg:justify-end">
            <a
              href="/product"
              class="inline-flex items-center gap-2 rounded-lg bg-primary-container px-6 py-3 text-sm font-semibold text-primary-on-container shadow-sm transition-opacity hover:opacity-90"
            >
              Read the architecture →
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================
       7. CTA BAND
       ================================================================ -->
  <CTABand
    title="The workspace AI was supposed to have."
    subtitle="Open source. Self-hostable. Works even when the AI is offline."
    cta={{ href: '/pricing#waitlist', label: 'Join the waitlist' }}
  />

</Layout>
