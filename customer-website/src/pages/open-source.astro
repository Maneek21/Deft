---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Card from '../components/Card.astro';
import BentoGrid from '../components/BentoGrid.astro';
import BentoItem from '../components/BentoItem.astro';
import CTABand from '../components/CTABand.astro';
import { GITHUB_URL } from '../config';
---

<Layout
  title="Deft — open source, self-hostable, your data stays yours"
  description="Deft is open source under the Business Source License 1.1 (BSL 1.1). Self-host on Docker Compose. Mandatory attribution in forks. The whole stack — Next.js, Hono, Postgres, BullMQ — is readable in a week."
>

  <!-- ================================================================
       1. SUBPAGE HERO
       ================================================================ -->
  <div class="relative">
    <div class="hero-bloom" aria-hidden="true"></div>
    <div class="max-w-3xl mx-auto text-center pt-24 pb-16 relative px-6">
      <p class="eyebrow mb-4">Open source</p>
      <h1 class="display mb-6">Own the system your agents reason over.</h1>
      <p class="lede mx-auto max-w-[600px]">
        Source-available under the Business Source License 1.1 (BSL 1.1). Self-hostable on Docker Compose. Mandatory
        attribution in forks. Your data stays in your Postgres.
      </p>
    </div>
  </div>

  <!-- ================================================================
       2. LICENSE
       ================================================================ -->
  <section id="license" class="py-20 md:py-28">
    <div class="mx-auto max-w-[1200px] px-6">
      <SectionHeader
        eyebrow="License"
        title="BSL 1.1 with one carve-out."
      />

      <div class="mt-12 grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-start">

        <!-- Left: explanation -->
        <div class="flex flex-col gap-4 text-[15px] text-ink-variant leading-relaxed">
          <p>
            Business Source License 1.1. You can use it for any purpose, run it in
            production, fork it, modify it, and ship it commercially. The one thing
            you can't do is offer Deft as a hosted service for third parties.
          </p>
          <p>
            That clause expires after four years — in 2030 — at which point the code
            converts to Apache 2.0. BSL 1.1 is the closest thing to open source that
            lets a small team keep building. We picked it deliberately.
          </p>
          <p>
            Mandatory attribution applies in forks. A visible credit and a link back.
            We're not picky about wording.
          </p>
        </div>

        <!-- Right: allowed / not allowed card -->
        <Card variant="default">
          <div class="flex flex-col gap-6">

            <div>
              <p class="text-[13px] font-semibold text-ink mb-3">What's allowed</p>
              <ul class="flex flex-col gap-2">
                {[
                  'Run in production',
                  'Fork and modify',
                  'Ship commercial features on top',
                  'Self-host for your own team',
                ].map((item) => (
                  <li class="flex items-center gap-2 text-[13px] text-ink-variant">
                    <svg class="flex-shrink-0 w-4 h-4 text-[color:var(--status-green)]" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path d="M3 8l3.5 3.5L13 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    {item}
                  </li>
                ))}
              </ul>
            </div>

            <div class="border-t border-ghost pt-6">
              <p class="text-[13px] font-semibold text-ink mb-3">What's not</p>
              <ul class="flex flex-col gap-2">
                <li class="flex items-center gap-2 text-[13px] text-ink-variant">
                  <svg class="flex-shrink-0 w-4 h-4 text-[color:var(--status-red)]" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                  Host as a service for third parties — until 2030
                </li>
              </ul>
            </div>

          </div>
        </Card>

      </div>
    </div>
  </section>

  <!-- ================================================================
       3. SELF-HOST
       ================================================================ -->
  <section id="self-host" class="py-20 md:py-28 bg-surface-container-low">
    <div class="mx-auto max-w-[1200px] px-6">
      <SectionHeader
        eyebrow="Self-host"
        title="Docker Compose. Five minutes. Done."
      />

      <div class="mt-12 grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-start">

        <!-- Left: description -->
        <div class="flex flex-col gap-4 text-[15px] text-ink-variant leading-relaxed">
          <p>
            The stack is Postgres, Redis, and a single Node.js process running both
            the Next.js frontend and the Hono API. One <code class="font-mono text-[13px] text-primary">docker-compose.yml</code>.
            No managed dependencies you don't own.
          </p>
          <p>
            Copy <code class="font-mono text-[13px] text-primary">.env.example</code> to
            <code class="font-mono text-[13px] text-primary">.env</code>, add your Anthropic API key,
            set a JWT secret, and you're done. Every environment variable is documented
            inline in the example file.
          </p>
          <p>
            Deploy to Railway, Fly.io, your own Kubernetes cluster, or your laptop.
            No vendor lock-in beyond what you write into your own environment. Production
            usage at any org size is explicitly permitted under BSL 1.1.
          </p>
        </div>

        <!-- Right: code block -->
        <pre class="font-mono text-[12px] bg-surface-container rounded-md p-6 overflow-x-auto leading-relaxed border border-ghost text-ink-variant"><span class="text-ink-outline"># clone the repo</span>
<span class="text-primary">git</span> clone {GITHUB_URL}
<span class="text-primary">cd</span> deft

<span class="text-ink-outline"># configure environment</span>
<span class="text-primary">cp</span> .env.example .env

<span class="text-ink-outline"># start postgres + redis + app</span>
<span class="text-primary">docker</span> compose up -d

<span class="text-ink-outline"># open in browser</span>
<span class="text-primary">open</span> http://localhost:3000</pre>

      </div>
    </div>
  </section>

  <!-- ================================================================
       4. STACK AT A GLANCE
       ================================================================ -->
  <section id="stack" class="py-20 md:py-28">
    <div class="mx-auto max-w-[1200px] px-6">
      <SectionHeader
        eyebrow="Stack"
        title="A stack a small team can read in a week."
      />

      <div class="mt-12">
        <BentoGrid>

          <BentoItem span={4}>
            <p class="eyebrow font-mono mb-2">Web — Next.js 14</p>
            <p class="font-semibold text-ink mb-2">App Router. Server Components. Tailwind.</p>
            <p class="text-[14px] text-ink-variant leading-relaxed">
              TypeScript strict mode throughout. No class components. Server components
              where possible. Client state with React hooks and SWR — nothing exotic.
            </p>
          </BentoItem>

          <BentoItem span={4}>
            <p class="eyebrow font-mono mb-2">API — Hono on Node.js</p>
            <p class="font-semibold text-ink mb-2">REST + WebSocket via Socket.io. Typed end to end.</p>
            <p class="text-[14px] text-ink-variant leading-relaxed">
              Zod validation on all request and response shapes. Hono's lightweight
              router. Socket.io with a Redis adapter for real-time events across workers.
            </p>
          </BentoItem>

          <BentoItem span={4}>
            <p class="eyebrow font-mono mb-2">Database — Postgres + pgvector</p>
            <p class="font-semibold text-ink mb-2">Drizzle ORM. Direct SQL where the agent needs it.</p>
            <p class="text-[14px] text-ink-variant leading-relaxed">
              Multi-tenant from day one — <code class="font-mono text-[12px] text-primary">org_id</code> on every table. pgvector enables
              semantic wiki search. UUIDs (cuid2) for primary keys. Soft deletes everywhere.
            </p>
          </BentoItem>

          <BentoItem span={4}>
            <p class="eyebrow font-mono mb-2">Workers — BullMQ + Redis</p>
            <p class="font-semibold text-ink mb-2">Heartbeat ticks. Durable reminders. GitHub sync.</p>
            <p class="text-[14px] text-ink-variant leading-relaxed">
              Scheduled jobs backed by Postgres, not in-process timeouts. BullMQ crons
              drive heartbeat dispatch, overdue task alerts, standup generation, and
              the PR-merge sync that closes referenced tasks.
            </p>
          </BentoItem>

          <BentoItem span={4}>
            <p class="eyebrow font-mono mb-2">Agents — Anthropic Claude</p>
            <p class="font-semibold text-ink mb-2">Sonnet for reasoning. Haiku for classification.</p>
            <p class="text-[14px] text-ink-variant leading-relaxed">
              Defty runs in-process via the Anthropic API. BYOA agents connect via MCP
              with an API key. The model is yours to swap — no lock-in at the runtime
              layer beyond your own API key.
            </p>
          </BentoItem>

          <BentoItem span={4}>
            <p class="eyebrow font-mono mb-2">Reliability — your runtime</p>
            <p class="font-semibold text-ink mb-2">Self-host anywhere. No vendor lock-in.</p>
            <p class="text-[14px] text-ink-variant leading-relaxed">
              Railway, Fly.io, your own Kubernetes, or a laptop. The only external
              dependency you can't swap out is Anthropic's API — and even that is
              injectable in the agent runner for testing.
            </p>
          </BentoItem>

        </BentoGrid>
      </div>
    </div>
  </section>

  <!-- ================================================================
       5. ATTRIBUTION CLAUSE
       ================================================================ -->
  <section id="attribution" class="py-12">
    <div class="mx-auto max-w-[1200px] px-6">
      <div class="bg-surface-container-low rounded-lg my-4 p-12 max-w-3xl mx-auto text-center border border-ghost">
        <p class="eyebrow mb-4">Mandatory attribution</p>
        <p class="text-[15px] text-ink-variant leading-relaxed max-w-[480px] mx-auto">
          Forks must credit Deft visibly in their UI. We're not picky about wording,
          but the link goes back. This is the closest thing source-available has to
          a "pay it forward" clause. It costs you one line of footer text. It keeps
          the attribution chain intact as the project forks and grows.
        </p>
      </div>
    </div>
  </section>

  <!-- ================================================================
       6. CTA BAND
       ================================================================ -->
  <CTABand
    title="Clone it. Run it. Ship it."
    cta={{ href: GITHUB_URL, label: 'View on GitHub →' }}
  />

</Layout>
