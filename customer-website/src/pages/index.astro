---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Card from '../components/Card.astro';
import CTABand from '../components/CTABand.astro';
import DashboardMock from '../components/mock/DashboardMock.astro';
import ApprovalCardMock from '../components/mock/ApprovalCardMock.astro';
import CrossRefMock from '../components/mock/CrossRefMock.astro';
import SQLDiffMock from '../components/mock/SQLDiffMock.astro';
---

<Layout
  title="Deft — the workspace your team and the agents will actually use"
  description="Six surfaces, one source of truth. Humans and agents working on the same data, with one approval trail. Open source, self-hostable, multi-tenant from day one."
>

  <!-- ================================================================
       1. HERO — workspace-first
       ================================================================ -->
  <Hero
    eyebrow="Humans + agents · One workspace"
    title="The workspace your team — and the agents — will actually use."
    subtitle="Six surfaces, one source of truth. Humans and agents working on the same data, with one approval trail and one bill at the end of the month."
    primaryCta={{ href: '/pricing#waitlist', label: 'Join the waitlist' }}
    secondaryCta={{ href: '/use-cases', label: 'Watch a real loop run →' }}
  >
    <div slot="visual" class="relative w-full">
      <DashboardMock />
      <div class="absolute -bottom-12 -right-6 hidden lg:block w-[60%] max-w-[400px]">
        <ApprovalCardMock />
      </div>
    </div>
  </Hero>

  <!-- ================================================================
       2. SIX SURFACES — the workspace proof
       ================================================================ -->
  <section id="surfaces" class="py-20 md:py-28 bg-surface-container-low">
    <div class="mx-auto max-w-[1200px] px-6">
      <SectionHeader
        eyebrow="Everything in one place"
        title="Six surfaces. One tool."
        subtitle="Chat where intent shows up. Tasks where work ships. Notes where it stays. Knowledge where it compounds. Calendar where time goes. Dashboard where it all lands."
        align="center"
      />

      <div class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        <a href="/chat" class="group block">
          <Card lift class="h-full">
            <div class="flex items-start justify-between mb-3">
              <p class="eyebrow">Chat</p>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-ink-outline group-hover:text-primary transition-colors" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
            </div>
            <p class="text-[16px] font-semibold text-ink mb-2">Where work shows up.</p>
            <p class="text-[13px] text-ink-variant leading-relaxed mb-3">
              Spaces, threads, mentions, reactions. Plus AI in the room that already knows what your team is working on.
            </p>
            <p class="font-mono text-[11px] text-ink-outline">@maneek raised a blocker → @deft proposed a plan → team approved</p>
          </Card>
        </a>

        <a href="/tasks" class="group block">
          <Card lift class="h-full">
            <div class="flex items-start justify-between mb-3">
              <p class="eyebrow">Tasks</p>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-ink-outline group-hover:text-primary transition-colors" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
            </div>
            <p class="text-[16px] font-semibold text-ink mb-2">Where it ships.</p>
            <p class="text-[13px] text-ink-variant leading-relaxed mb-3">
              Six clear statuses, priorities, recurrence, reactions, mentions. When a PR is merged, the task closes itself.
            </p>
            <p class="font-mono text-[11px] text-ink-outline">Created by @defty from #eng mention · assigned to @maneek</p>
          </Card>
        </a>

        <a href="/notes" class="group block">
          <Card lift class="h-full">
            <div class="flex items-start justify-between mb-3">
              <p class="eyebrow">Notes</p>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-ink-outline group-hover:text-primary transition-colors" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="15" y2="17"/></svg>
            </div>
            <p class="text-[16px] font-semibold text-ink mb-2">Where it stays.</p>
            <p class="text-[13px] text-ink-variant leading-relaxed mb-3">
              Daily notes, free notes, decisions. Promote any note to a wiki page in one tap. Mentions and links work everywhere.
            </p>
            <p class="font-mono text-[11px] text-ink-outline">Promoted by @defty · co-edited with @maneek</p>
          </Card>
        </a>

        <a href="/knowledge" class="group block">
          <Card lift class="h-full">
            <div class="flex items-start justify-between mb-3">
              <p class="eyebrow">Knowledge</p>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-ink-outline group-hover:text-primary transition-colors" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            </div>
            <p class="text-[16px] font-semibold text-ink mb-2">Where it compounds.</p>
            <p class="text-[13px] text-ink-variant leading-relaxed mb-3">
              Wiki, decisions, daily notes — all searchable in one place. Search by keyword, by meaning, or both. Every AI answer cites its source.
            </p>
            <p class="font-mono text-[11px] text-ink-outline">Search "session token storage"</p>
          </Card>
        </a>

        <a href="/calendar" class="group block">
          <Card lift class="h-full">
            <div class="flex items-start justify-between mb-3">
              <p class="eyebrow">Calendar</p>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-ink-outline group-hover:text-primary transition-colors" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <p class="text-[16px] font-semibold text-ink mb-2">Where time goes.</p>
            <p class="text-[13px] text-ink-variant leading-relaxed mb-3">
              Google Calendar in the room with the work. Meeting prep auto-generates the morning of. Reminders that survive restarts.
            </p>
            <p class="font-mono text-[11px] text-ink-outline">Standup auto-drafted by @defty · sent by @maneek</p>
          </Card>
        </a>

        <a href="/dashboard" class="group block">
          <Card lift class="h-full">
            <div class="flex items-start justify-between mb-3">
              <p class="eyebrow">Dashboard</p>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-ink-outline group-hover:text-primary transition-colors" aria-hidden="true"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>
            </div>
            <p class="text-[16px] font-semibold text-ink mb-2">Where it all lands.</p>
            <p class="text-[13px] text-ink-variant leading-relaxed mb-3">
              My Work scoped to you. Pending agent actions you can approve inline. A daily briefing the AI writes for you.
            </p>
            <p class="font-mono text-[11px] text-ink-outline">My Work · Briefing · Agent Activity · Focus</p>
          </Card>
        </a>
      </div>

      <div class="mt-12 text-center">
        <a href="/workspace" class="inline-flex items-center gap-1.5 text-[13px] font-medium text-primary hover:opacity-80">
          See how the surfaces fit together
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ================================================================
       3. THE THREAD OF WORK — integration story
       ================================================================ -->
  <section id="thread" class="py-20 md:py-28">
    <div class="mx-auto max-w-[1200px] px-6">
      <SectionHeader
        eyebrow="How it connects"
        title="A single thread of work, end to end."
        subtitle="The surfaces aren't silos. A chat message becomes a task. A task implements a decision. A decision documents a wiki page. Every step stays linked — and the AI follows the thread without losing the context."
        align="center"
      />

      <div class="mt-16 flex justify-center">
        <div class="w-full max-w-5xl">
          <CrossRefMock />
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================
       4. THREE WORKSPACE PRINCIPLES (replaces agent principles)
       ================================================================ -->
  <section class="py-20 md:py-28 bg-surface-container-low">
    <div class="mx-auto max-w-[1200px] px-6">
      <SectionHeader
        eyebrow="Why Deft is different"
        title="The workspace, then the AI."
        subtitle="Most AI tools are bolted on top of someone else's workspace. Deft is a workspace first — built so the AI can actually read it."
        align="center"
      />

      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
        <Card variant="subtle">
          <p class="eyebrow mb-3">One workspace</p>
          <p class="mb-2 text-[18px] font-semibold text-ink leading-snug">
            Six surfaces, one tool, one login.
          </p>
          <p class="text-[14px] text-ink-variant leading-relaxed">
            Stop renting your team's context to six SaaS vendors. Chat, tasks, notes,
            calendar, knowledge, and dashboard — all in one tool, with one source of truth
            and one bill at the end of the month.
          </p>
        </Card>

        <Card variant="subtle">
          <p class="eyebrow mb-3">One source of truth</p>
          <p class="mb-2 text-[18px] font-semibold text-ink leading-snug">
            Every surface shares the same data.
          </p>
          <p class="text-[14px] text-ink-variant leading-relaxed">
            Your dashboard, your search, and the AI all read the same data. Mention a task
            in chat and it's the same task — not a copy. That's why the AI works here, and
            why bolt-on AI doesn't.
          </p>
        </Card>

        <Card variant="subtle">
          <p class="eyebrow mb-3">Open by default</p>
          <p class="mb-2 text-[18px] font-semibold text-ink leading-snug">
            Open source. Self-hostable. Yours.
          </p>
          <p class="text-[14px] text-ink-variant leading-relaxed">
            Source-available under the Business Source License 1.1. Self-host on Docker
            Compose. Multi-tenant from day one — your data stays where you put it.
            Read the code if you want.
          </p>
        </Card>
      </div>
    </div>
  </section>

  <!-- ================================================================
       5. WHY YOUR STACK CAN'T DO THIS — workspace differentiation
       ================================================================ -->
  <section class="py-20 md:py-28">
    <div class="mx-auto max-w-[1200px] px-6">
      <SectionHeader
        eyebrow="The real differentiator"
        title="Notion plus Linear plus a chatbot can't do this."
        subtitle="When you spread your team across separate apps, AI in any of them only sees a slice. Deft puts the surfaces in one tool — so the AI sees the whole thread of work."
        align="center"
      />

      <div class="mt-12 flex justify-center">
        <div class="w-full max-w-5xl">
          <SQLDiffMock />
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================
       6. THE AGENT COMES WITH THE WORKSPACE — short, plain
       ================================================================ -->
  <section class="py-20 md:py-28 bg-surface-container-low">
    <div class="mx-auto max-w-[1200px] px-6">
      <div class="grid lg:grid-cols-[1.15fr_1fr] gap-12 items-center">
        <div>
          <SectionHeader
            eyebrow="The AI multiplier"
            title="The AI is good because the workspace is built for it."
            subtitle="Defty is the built-in AI. Claude Code, Claude Desktop, Codex, Cursor, or any client speaking the Model Context Protocol can connect with one API key — same approval rails, same audit trail."
          />
          <ul class="mt-8 space-y-3 text-[14px] text-ink-variant">
            <li class="flex items-start gap-3">
              <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-status-green flex-shrink-0" aria-hidden="true"></span>
              <span>Three trust levels — Conservative, Standard, Autonomous — picked per agent.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-status-amber flex-shrink-0" aria-hidden="true"></span>
              <span>Three approval tiers — Auto-execute, Quick-approve, Full-review — per action.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-status-blue flex-shrink-0" aria-hidden="true"></span>
              <span>Daily budgets, circuit breakers, spend caps. The AI gets paused before it gets expensive.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-primary flex-shrink-0" aria-hidden="true"></span>
              <span>Humans approve. Agents act. Always linked. Every external write is a row in <code class="font-mono text-[12px] text-primary">agent_actions</code> with the approver's name on it.</span>
            </li>
          </ul>
          <p class="mt-8">
            <a href="/agents" class="inline-flex items-center gap-1.5 text-[13px] font-medium text-primary hover:opacity-80">
              How agents work in Deft
              <span aria-hidden="true">→</span>
            </a>
          </p>
        </div>

        <div class="flex justify-center">
          <ApprovalCardMock />
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================
       7. RELIABLE WITHOUT AI — short callout
       ================================================================ -->
  <section class="py-16">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <p class="eyebrow mb-4">Reliable without AI</p>
      <h2 class="section-title mb-4">Pull the AI out. The workspace still works.</h2>
      <p class="lede">
        Chat sends messages. Kanban moves cards. Notes save. Standups still post. Deft is a
        workspace that happens to have an AI — not an AI with a UI bolted on.
      </p>
    </div>
  </section>

  <!-- ================================================================
       8. TRUST SIGNAL — open source, self-host, multi-tenant
       ================================================================ -->
  <section class="py-20 md:py-28 bg-surface-container-low">
    <div class="mx-auto max-w-[1200px] px-6">
      <div class="grid lg:grid-cols-[1.1fr_1fr] gap-12 items-center">
        <div>
          <SectionHeader
            eyebrow="Built on trust"
            title="Open source. Self-hostable. Multi-tenant from day one."
            subtitle="The Business Source License 1.1 means you can run Deft for your team, fork it, and ship commercial features. Mandatory attribution in forks. No service-as-substitute clause: we can't pull the rug, and neither can anyone who forks us."
          />
          <p class="mt-6">
            <a href="/open-source" class="inline-flex items-center gap-1.5 text-[13px] font-medium text-primary hover:opacity-80">
              See the license
              <span aria-hidden="true">→</span>
            </a>
          </p>
        </div>

        <Card variant="subtle">
          <ul class="space-y-5">
            <li class="flex items-start gap-3">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-status-green flex-shrink-0 mt-0.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              <div>
                <p class="font-semibold text-ink text-[14px] mb-0.5">Open source under BSL 1.1</p>
                <p class="text-[13px] text-ink-variant">Run it commercially. Fork it. Read the code. Convert to Apache 2.0 in 2030.</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-status-green flex-shrink-0 mt-0.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              <div>
                <p class="font-semibold text-ink text-[14px] mb-0.5">Self-host in five minutes</p>
                <p class="text-[13px] text-ink-variant">Docker Compose. Postgres + Redis + the app. Done.</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-status-green flex-shrink-0 mt-0.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              <div>
                <p class="font-semibold text-ink text-[14px] mb-0.5">Tenant isolation, every query</p>
                <p class="text-[13px] text-ink-variant">Org-level isolation built into the database. No shared cache. No exceptions.</p>
              </div>
            </li>
          </ul>
        </Card>
      </div>
    </div>
  </section>

  <!-- ================================================================
       9. CTA BAND
       ================================================================ -->
  <CTABand
    title="The workspace your team will actually use."
    subtitle="With AI that earns its place."
    cta={{ href: '/pricing#waitlist', label: 'Join the waitlist' }}
  />

</Layout>
