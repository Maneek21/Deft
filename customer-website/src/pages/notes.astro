---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Card from '../components/Card.astro';
import CTABand from '../components/CTABand.astro';
import NoteEditorMock from '../components/mock/NoteEditorMock.astro';
import SurfaceFooter from '../components/SurfaceFooter.astro';
---

<Layout
  title="Deft — notes that don't get lost in chat"
  description="Daily notes auto-organized by date. Free notes for whatever. Mentions and links work everywhere. Promote any note to a wiki page in one tap. The AI searches them all."
>

  <!-- ================================================================
       1. SUBPAGE HERO
       ================================================================ -->
  <div class="relative">
    <div class="hero-bloom" aria-hidden="true"></div>
    <div class="max-w-3xl mx-auto text-center pt-24 pb-16 px-6 relative">
      <p class="eyebrow mb-4">Notes</p>
      <h1 class="display mb-6">Notes that don't get lost in chat.</h1>
      <p class="lede mx-auto">
        Daily notes auto-organized by date. Free notes for whatever. Mentions and links
        work everywhere. Promote any note to a wiki page in one tap. The AI searches
        them all.
      </p>
    </div>
  </div>

  <!-- ================================================================
       2. BIG VISUAL — NoteEditorMock
       ================================================================ -->
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="flex justify-center mt-16 overflow-x-auto">
      <NoteEditorMock class="max-w-3xl w-full" />
    </div>
  </div>

  <!-- ================================================================
       3. DAILY NOTES
       ================================================================ -->
  <section id="daily" class="py-20 md:py-28">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">

        <!-- Left: copy -->
        <SectionHeader
          eyebrow="01 · Daily notes"
          title="One date. One note. Auto-organized."
          subtitle="A note per day, per person. If two people edit the same note at once, the second is asked to merge — no silent overwrites. Mentions in daily notes are searchable across the whole team."
        />

        <!-- Right: recent daily notes list -->
        <Card variant="default">
          <p class="text-[12px] font-semibold text-ink-variant mb-4 uppercase tracking-wide">Recent daily notes</p>
          <div class="flex flex-col divide-y divide-ghost">

            <div class="flex items-baseline gap-3 py-3 first:pt-0">
              <span class="font-mono text-primary font-semibold flex-shrink-0" style="font-size: 13px;">2026-04-21</span>
              <span class="text-ink-outline" style="font-size: 11px;">·</span>
              <span class="text-ink flex-1" style="font-size: 13px;">Auth migration sync</span>
              <span class="font-mono text-ink-outline flex-shrink-0" style="font-size: 11px;">14 mentions · 3 task links</span>
            </div>

            <div class="flex items-baseline gap-3 py-3">
              <span class="font-mono text-primary font-semibold flex-shrink-0" style="font-size: 13px;">2026-04-20</span>
              <span class="text-ink-outline" style="font-size: 11px;">·</span>
              <span class="text-ink flex-1" style="font-size: 13px;">Sprint 7 wrap</span>
              <span class="font-mono text-ink-outline flex-shrink-0" style="font-size: 11px;">8 mentions · 2 decisions cited</span>
            </div>

            <div class="flex items-baseline gap-3 py-3">
              <span class="font-mono text-primary font-semibold flex-shrink-0" style="font-size: 13px;">2026-04-19</span>
              <span class="text-ink-outline" style="font-size: 11px;">·</span>
              <span class="text-ink flex-1" style="font-size: 13px;">Saturday catch-up</span>
              <span class="font-mono text-ink-outline flex-shrink-0" style="font-size: 11px;">2 mentions</span>
            </div>

            <div class="flex items-baseline gap-3 py-3">
              <span class="font-mono text-primary font-semibold flex-shrink-0" style="font-size: 13px;">2026-04-18</span>
              <span class="text-ink-outline" style="font-size: 11px;">·</span>
              <span class="text-ink flex-1" style="font-size: 13px;">Friday journal</span>
              <span class="font-mono text-ink-outline flex-shrink-0" style="font-size: 11px;">6 mentions</span>
            </div>

            <div class="flex items-baseline gap-3 py-3 last:pb-0">
              <span class="font-mono text-primary font-semibold flex-shrink-0" style="font-size: 13px;">2026-04-17</span>
              <span class="text-ink-outline" style="font-size: 11px;">·</span>
              <span class="text-ink flex-1" style="font-size: 13px;">Standup notes</span>
              <span class="font-mono text-ink-outline flex-shrink-0" style="font-size: 11px;">11 mentions</span>
            </div>

          </div>
        </Card>

      </div>
    </div>
  </section>

  <!-- ================================================================
       4. FREE NOTES
       ================================================================ -->
  <section id="free" class="py-20 md:py-28 bg-surface-container-low">
    <div class="max-w-[1200px] mx-auto px-6">
      <SectionHeader
        eyebrow="02 · Free notes"
        title="Anywhere notes for thoughts, drafts, scratchpads."
        subtitle="Not tied to a date. Searchable by keyword and by meaning. The AI can read your notes, search them, draft new ones (with your approval), and promote a note to a wiki page."
        align="center"
      />

      <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">

        <Card variant="subtle">
          <p class="text-[13px] font-semibold text-ink mb-2">Search</p>
          <p class="text-[13px] text-ink-variant leading-relaxed">
            Find a note by keyword or by meaning.
          </p>
        </Card>

        <Card variant="subtle">
          <p class="text-[13px] font-semibold text-ink mb-2">Read</p>
          <p class="text-[13px] text-ink-variant leading-relaxed">
            The AI pulls the full note when you ask.
          </p>
        </Card>

        <Card variant="subtle">
          <p class="text-[13px] font-semibold text-ink mb-2">Draft</p>
          <p class="text-[13px] text-ink-variant leading-relaxed">
            The AI suggests a note; you approve before it lands.
          </p>
        </Card>

        <Card variant="subtle">
          <p class="text-[13px] font-semibold text-ink mb-2">Promote</p>
          <p class="text-[13px] text-ink-variant leading-relaxed">
            Turn any note into a versioned wiki page in one tap.
          </p>
        </Card>

      </div>
    </div>
  </section>

  <!-- ================================================================
       5. DECISION CAPTURE
       ================================================================ -->
  <section id="decisions" class="py-20 md:py-28">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">

        <!-- Left: copy -->
        <SectionHeader
          eyebrow="03 · Decisions"
          title="Capture decisions. Link them to the work that follows."
          subtitle="A decision is their own thing. Link it to the tasks that implement it. When the implementing work ships, the decision is marked implemented automatically. Six months later, you can answer 'why did we do this?' in seconds."
        />

        <!-- Right: decision detail card -->
        <Card variant="default">

          <!-- Header -->
          <div class="mb-4 pb-4 border-b border-ghost">
            <p class="text-ink font-semibold leading-snug mb-1" style="font-size: 15px;">
              Move session storage from cookie to Postgres
            </p>
            <p class="text-ink-outline font-mono" style="font-size: 11px;">
              Decided 2026-04-08 · Implemented 2026-04-21 · 4 linked tasks
            </p>
          </div>

          <!-- Linked tasks -->
          <div class="flex flex-col gap-2 mb-4">
            <div class="flex items-center gap-2">
              <span class="font-mono text-ink-variant" style="font-size: 12px;">ENG-141</span>
              <span class="rounded-md font-mono font-semibold" style="font-size: 10px; padding: 1px 6px; background: rgba(48, 164, 108, 0.12); color: var(--status-green);">done</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="font-mono text-ink-variant" style="font-size: 12px;">ENG-142</span>
              <span class="rounded-md font-mono font-semibold" style="font-size: 10px; padding: 1px 6px; background: rgba(48, 164, 108, 0.12); color: var(--status-green);">done</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="font-mono text-ink-variant" style="font-size: 12px;">ENG-143</span>
              <span class="rounded-md font-mono font-semibold" style="font-size: 10px; padding: 1px 6px; background: rgba(48, 164, 108, 0.12); color: var(--status-green);">done</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="font-mono text-ink-variant" style="font-size: 12px;">ENG-144</span>
              <span class="rounded-md font-mono font-semibold" style="font-size: 10px; padding: 1px 6px; background: rgba(59, 130, 246, 0.12); color: var(--status-blue);">in_review</span>
            </div>
          </div>

          <!-- Footer link -->
          <div slot="footer">
            <a href="/knowledge#decisions" class="text-primary text-[13px] font-medium hover:underline">Read the wiki page →</a>
          </div>

        </Card>

      </div>
    </div>
  </section>

  <!-- ================================================================
       6. NOTE → WIKI PROMOTION
       ================================================================ -->
  <section id="promotion" class="py-20 md:py-28 bg-surface-container-low">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

        <!-- Left: before/after promotion visual -->
        <Card variant="default">
          <p class="text-[12px] font-semibold text-ink-variant mb-5 uppercase tracking-wide">Promote to wiki</p>

          <div class="flex items-center gap-4">

            <!-- Before: note state -->
            <div class="flex-1 rounded-md border border-ghost p-3 bg-surface-container-low">
              <div class="flex items-center gap-2 mb-2">
                <svg width="13" height="13" viewBox="0 0 13 13" fill="none" style="color: var(--outline); flex-shrink: 0;">
                  <path d="M2 2.5a1 1 0 0 1 1-1h7a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1v-8Z" stroke="currentColor" stroke-width="1.1"/>
                  <path d="M4 5h5M4 7h3" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
                </svg>
                <span class="text-ink-outline" style="font-size: 11px; font-weight: 500;">Note</span>
              </div>
              <p class="text-ink-variant font-mono" style="font-size: 11px; line-height: 1.5;">Auth middleware overview</p>
              <p class="text-ink-outline font-mono mt-1" style="font-size: 10px;">draft · unsaved</p>
            </div>

            <!-- Arrow -->
            <div class="flex flex-col items-center gap-1 flex-shrink-0">
              <svg width="24" height="16" viewBox="0 0 24 16" fill="none" style="color: var(--primary);">
                <path d="M1 8h20M15 2l6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span class="text-ink-outline" style="font-size: 10px;">promote</span>
            </div>

            <!-- After: wiki state -->
            <div class="flex-1 rounded-md border p-3" style="background: rgba(48, 164, 108, 0.06); border-color: rgba(48, 164, 108, 0.25);">
              <div class="flex items-center gap-2 mb-2">
                <svg width="13" height="13" viewBox="0 0 13 13" fill="none" style="color: var(--status-green); flex-shrink: 0;">
                  <rect x="1.5" y="1" width="10" height="11" rx="1.5" stroke="currentColor" stroke-width="1.1"/>
                  <path d="M4 5h5M4 7h5M4 9h3" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
                </svg>
                <span style="font-size: 11px; font-weight: 500; color: var(--status-green);">Wiki page</span>
              </div>
              <p class="text-ink-variant font-mono" style="font-size: 11px; line-height: 1.5;">auth-middleware-overview</p>
              <p class="font-mono mt-1" style="font-size: 10px; color: var(--status-green);">rev 1 · indexed</p>
            </div>

          </div>

          <p class="text-ink-outline text-[12px] mt-4">The original note keeps a back-link. The wiki page can be cited by the AI in future answers.</p>
        </Card>

        <!-- Right: copy -->
        <SectionHeader
          eyebrow="04 · Promotion"
          title="Note → wiki, in one tap."
          subtitle="Versioned. Search-indexed. The original note keeps a back-link. The wiki page can be cited by the AI in future answers. One tap, no admin override required."
        />

      </div>
    </div>
  </section>

  <!-- ================================================================
       7. TIPTAP RICH CONTENT
       ================================================================ -->
  <section id="content" class="py-20 md:py-28">
    <div class="max-w-[1200px] mx-auto px-6">
      <SectionHeader
        eyebrow="Rich content"
        title="Headings, lists, code blocks, embeds, mentions."
        subtitle="Notes resolve @-mentions to org members. Tasks, decisions, and other notes embed by reference. The basics, done well — without the bloat."
        align="center"
      />

      <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-4xl mx-auto">

        <Card variant="subtle">
          <p class="text-[13px] font-semibold text-ink mb-2">Headings + lists</p>
          <p class="text-[13px] text-ink-variant leading-relaxed">H1–H3, bullet, numbered, checklist. What you'd expect from a modern editor.</p>
        </Card>

        <Card variant="subtle">
          <p class="text-[13px] font-semibold text-ink mb-2">@-mentions</p>
          <p class="text-[13px] text-ink-variant leading-relaxed">Inline mention resolves to org members. Autocomplete, notification dispatch, searchable.</p>
        </Card>

        <Card variant="subtle">
          <p class="text-[13px] font-semibold text-ink mb-2">Code blocks</p>
          <p class="text-[13px] text-ink-variant leading-relaxed">Syntax-friendly monospace. Copy-to-clipboard. Renders in the AI's context too.</p>
        </Card>

        <Card variant="subtle">
          <p class="text-[13px] font-semibold text-ink mb-2">Embedded refs</p>
          <p class="text-[13px] text-ink-variant leading-relaxed">Inline references to tasks, decisions, and notes. Structured, not flat text.</p>
        </Card>

      </div>
    </div>
  </section>

  <!-- ================================================================
       8. SURFACE FOOTER + CTA BAND
       ================================================================ -->
  <SurfaceFooter current="notes" />

  <CTABand
    title="Notes the AI can actually read."
    cta={{ href: '/pricing#waitlist', label: 'Join the waitlist' }}
  />

</Layout>
