---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Card from '../components/Card.astro';
import CTABand from '../components/CTABand.astro';
import TaskKanbanMock from '../components/mock/TaskKanbanMock.astro';
import TaskDetailMock from '../components/mock/TaskDetailMock.astro';
import SurfaceFooter from '../components/SurfaceFooter.astro';
---

<Layout
  title="Deft — tasks built for shipping"
  description="Six clear statuses. Priorities, recurring tasks, reactions, mentions in description and comments. When your engineers merge a PR that mentions a task, the task closes itself."
>

  <!-- ================================================================
       1. SUBPAGE HERO
       ================================================================ -->
  <div class="relative">
    <div class="hero-bloom" aria-hidden="true"></div>
    <div class="max-w-3xl mx-auto text-center pt-24 pb-16 px-6 relative">
      <p class="eyebrow mb-4">Tasks</p>
      <h1 class="display mb-6">Built for shipping. Not for filling out forms.</h1>
      <p class="lede mx-auto max-w-[640px]">
        Six clear statuses. Priorities, recurring tasks, reactions, mentions in
        description and comments. When your engineers merge a PR that mentions a task,
        the task closes itself.
      </p>
    </div>
  </div>

  <!-- ================================================================
       2. BIG VISUAL — Kanban + Detail side by side
       ================================================================ -->
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-8 items-start mt-16">
      <div class="flex items-center justify-center overflow-x-auto">
        <TaskKanbanMock />
      </div>
      <div class="flex items-center justify-center">
        <TaskDetailMock />
      </div>
    </div>
  </div>

  <!-- ================================================================
       3. FIVE VIEWS
       ================================================================ -->
  <section id="views" class="py-20 md:py-28">
    <div class="max-w-[1200px] mx-auto px-6">
      <SectionHeader
        eyebrow="01 · Views"
        title="Five views. One model."
        subtitle="Pick the view that fits the work. Kanban for the day, List when you need to bulk-edit, Timeline for sequencing, Calendar for due dates, Pipeline for funnel-style flows. Your choice persists across sessions."
        align="center"
      />

      <div class="mt-12 flex flex-wrap gap-4 justify-center">

        <Card variant="subtle" class="flex-1 min-w-[180px] max-w-[220px]">
          <p class="eyebrow mb-1">Kanban</p>
          <p class="text-[14px] font-semibold text-ink mb-1">Default</p>
          <p class="text-[13px] text-ink-variant">Drag-and-drop columns. Default view.</p>
        </Card>

        <Card variant="subtle" class="flex-1 min-w-[180px] max-w-[220px]">
          <p class="eyebrow mb-1">List</p>
          <p class="text-[14px] font-semibold text-ink mb-1">Bulk edit</p>
          <p class="text-[13px] text-ink-variant">Sort, filter, bulk-edit.</p>
        </Card>

        <Card variant="subtle" class="flex-1 min-w-[180px] max-w-[220px]">
          <p class="eyebrow mb-1">Timeline</p>
          <p class="text-[14px] font-semibold text-ink mb-1">Gantt-style</p>
          <p class="text-[13px] text-ink-variant">See dependencies and sequencing.</p>
        </Card>

        <Card variant="subtle" class="flex-1 min-w-[180px] max-w-[220px]">
          <p class="eyebrow mb-1">Calendar</p>
          <p class="text-[14px] font-semibold text-ink mb-1">Due dates</p>
          <p class="text-[13px] text-ink-variant">Due dates on a month grid.</p>
        </Card>

        <Card variant="subtle" class="flex-1 min-w-[180px] max-w-[220px]">
          <p class="eyebrow mb-1">Pipeline</p>
          <p class="text-[14px] font-semibold text-ink mb-1">Funnel-style</p>
          <p class="text-[13px] text-ink-variant">Funnel-style for sales or CS flows.</p>
        </Card>

      </div>
    </div>
  </section>

  <!-- ================================================================
       4. STATUS VOCABULARY
       ================================================================ -->
  <section id="status" class="py-20 md:py-28 bg-surface-container-low">
    <div class="max-w-[1200px] mx-auto px-6">
      <SectionHeader
        eyebrow="02 · Status"
        title="Six statuses. Made for engineering teams."
        subtitle="backlog → todo → in_progress → in_review → done | cancelled. No 'on-hold,' no 'blocked-by-Susan.' Same vocabulary across every project — so the same dashboards work everywhere."
        align="center"
      />

      <div class="flex flex-wrap gap-3 mt-12 justify-center">

        <!-- backlog: status-gray -->
        <div class="flex items-center gap-2 rounded-md px-4 py-2 border border-ghost bg-surface-container">
          <span class="rounded-full flex-shrink-0" style="width: 8px; height: 8px; background: var(--status-gray);"></span>
          <span class="font-mono text-[13px] text-ink">backlog</span>
        </div>

        <!-- todo: status-blue -->
        <div class="flex items-center gap-2 rounded-md px-4 py-2 border border-ghost bg-surface-container">
          <span class="rounded-full flex-shrink-0" style="width: 8px; height: 8px; background: var(--status-blue);"></span>
          <span class="font-mono text-[13px] text-ink">todo</span>
        </div>

        <!-- in_progress: status-amber -->
        <div class="flex items-center gap-2 rounded-md px-4 py-2 border border-ghost bg-surface-container">
          <span class="rounded-full flex-shrink-0" style="width: 8px; height: 8px; background: var(--status-amber);"></span>
          <span class="font-mono text-[13px] text-ink">in_progress</span>
        </div>

        <!-- in_review: primary-container -->
        <div class="flex items-center gap-2 rounded-md px-4 py-2 border border-ghost bg-surface-container">
          <span class="rounded-full flex-shrink-0" style="width: 8px; height: 8px; background: var(--primary-container);"></span>
          <span class="font-mono text-[13px] text-ink">in_review</span>
        </div>

        <!-- done: status-green -->
        <div class="flex items-center gap-2 rounded-md px-4 py-2 border border-ghost bg-surface-container">
          <span class="rounded-full flex-shrink-0" style="width: 8px; height: 8px; background: var(--status-green);"></span>
          <span class="font-mono text-[13px] text-ink">done</span>
        </div>

        <!-- cancelled: status-red -->
        <div class="flex items-center gap-2 rounded-md px-4 py-2 border border-ghost bg-surface-container">
          <span class="rounded-full flex-shrink-0" style="width: 8px; height: 8px; background: var(--status-red);"></span>
          <span class="font-mono text-[13px] text-ink">cancelled</span>
        </div>

      </div>
    </div>
  </section>

  <!-- ================================================================
       5. PR → DONE AUTOMATION
       ================================================================ -->
  <section id="github" class="py-20 md:py-28">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">

        <!-- Left: copy -->
        <SectionHeader
          eyebrow="03 · GitHub"
          title="PR merged → task done. Always."
          subtitle="PR titles that mention a task ID move the task to done — automatically. The activity log shows the link. Tasks already done or cancelled are never re-touched."
        />

        <!-- Right: activity timeline card -->
        <Card variant="default">
          <p class="text-[12px] font-semibold text-ink-variant mb-4 uppercase tracking-wide">Activity log — ENG-142</p>
          <div class="flex flex-col gap-0" style="position: relative;">
            <!-- vertical line -->
            <div style="position: absolute; left: 9px; top: 12px; bottom: 12px; width: 1px; background: var(--ghost-border);"></div>

            <!-- entry 1 -->
            <div class="flex items-start gap-2.5 py-2">
              <span class="flex items-center justify-center rounded-full flex-shrink-0" style="width: 20px; height: 20px; background: var(--surface-container-highest); z-index: 1;">
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none" style="color: var(--outline);"><circle cx="5" cy="3.5" r="2" stroke="currentColor" stroke-width="1.1"/><path d="M1 9c0-2.2 1.8-4 4-4s4 1.8 4 4" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/></svg>
              </span>
              <div class="flex-1 min-w-0">
                <span class="font-mono text-ink-outline" style="font-size: 10px;">11:02 AM</span>
                <span class="text-ink-outline" style="font-size: 10px; margin: 0 4px;">·</span>
                <span class="text-ink font-medium" style="font-size: 12px;">GitHub</span>
                <p class="text-ink-variant font-mono mt-0.5" style="font-size: 11px; line-height: 1.5;">opened PR #1247 'fix(auth): use Postgres-backed sessions [ENG-142]'</p>
              </div>
            </div>

            <!-- entry 2 -->
            <div class="flex items-start gap-2.5 py-2">
              <span class="flex items-center justify-center rounded-full flex-shrink-0 font-bold" style="width: 20px; height: 20px; background: var(--primary-container); font-size: 8px; color: var(--on-primary-container); z-index: 1;">D</span>
              <div class="flex-1 min-w-0">
                <span class="font-mono text-ink-outline" style="font-size: 10px;">11:04 AM</span>
                <span class="text-ink-outline" style="font-size: 10px; margin: 0 4px;">·</span>
                <span class="text-ink font-medium" style="font-size: 12px;">Defty</span>
                <p class="text-ink-variant font-mono mt-0.5" style="font-size: 11px;">linked PR to ENG-142</p>
              </div>
            </div>

            <!-- entry 3 -->
            <div class="flex items-start gap-2.5 py-2">
              <span class="flex items-center justify-center rounded-full flex-shrink-0" style="width: 20px; height: 20px; background: var(--surface-container-highest); z-index: 1;">
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none" style="color: var(--outline);"><circle cx="5" cy="3.5" r="2" stroke="currentColor" stroke-width="1.1"/><path d="M1 9c0-2.2 1.8-4 4-4s4 1.8 4 4" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/></svg>
              </span>
              <div class="flex-1 min-w-0">
                <span class="font-mono text-ink-outline" style="font-size: 10px;">3:45 PM</span>
                <span class="text-ink-outline" style="font-size: 10px; margin: 0 4px;">·</span>
                <span class="text-ink font-medium" style="font-size: 12px;">GitHub</span>
                <p class="text-ink-variant font-mono mt-0.5" style="font-size: 11px;">merged PR #1247 by maneek</p>
              </div>
            </div>

            <!-- entry 4 -->
            <div class="flex items-start gap-2.5 py-2">
              <span class="flex items-center justify-center rounded-full flex-shrink-0" style="width: 20px; height: 20px; background: var(--surface-container-low); border: 1px solid var(--ghost-border); z-index: 1;">
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none" style="color: var(--status-green);"><path d="M1.5 5l2.5 2.5 5-5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <div class="flex-1 min-w-0">
                <span class="font-mono text-ink-outline" style="font-size: 10px;">3:45 PM</span>
                <span class="text-ink-outline" style="font-size: 10px; margin: 0 4px;">·</span>
                <span class="text-ink font-medium" style="font-size: 12px;">System</span>
                <p class="font-mono mt-0.5" style="font-size: 11px; color: var(--status-green);">ENG-142 → done · 'Closed by PR #1247'</p>
              </div>
            </div>

          </div>
        </Card>

      </div>
    </div>
  </section>

  <!-- ================================================================
       6. WORKFLOW EXECUTOR
       ================================================================ -->
  <section id="workflows" class="py-20 md:py-28 bg-surface-container-low">
    <div class="max-w-[1200px] mx-auto px-6">
      <SectionHeader
        eyebrow="04 · Workflows"
        title="When a task changes, fire automated actions."
        subtitle="Add a comment. Reassign. Add a label. Send a notification. Unblock dependent tasks. The actions are simple and named — no scripting required."
        align="center"
      />

      <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">

        <Card variant="subtle">
          <p class="font-mono text-primary text-[12px] mb-2">→ add_comment</p>
          <p class="text-[13px] text-ink-variant">Drop a structured comment on the task.</p>
        </Card>

        <Card variant="subtle">
          <p class="font-mono text-primary text-[12px] mb-2">→ assign_to</p>
          <p class="text-[13px] text-ink-variant">Change the assignee with audit trail.</p>
        </Card>

        <Card variant="subtle">
          <p class="font-mono text-primary text-[12px] mb-2">→ add_label</p>
          <p class="text-[13px] text-ink-variant">Tag the task.</p>
        </Card>

        <Card variant="subtle">
          <p class="font-mono text-primary text-[12px] mb-2">→ notify</p>
          <p class="text-[13px] text-ink-variant">Fan out a notification to a user or space.</p>
        </Card>

        <Card variant="subtle">
          <p class="font-mono text-primary text-[12px] mb-2">→ unblock_dependents</p>
          <p class="text-[13px] text-ink-variant">DM each open dependent task's assignee when this one ships.</p>
        </Card>

      </div>
    </div>
  </section>

  <!-- ================================================================
       7. RECURRENCE
       ================================================================ -->
  <section id="recurrence" class="py-20 md:py-28">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

        <!-- Left: recurring task UI mock -->
        <Card variant="default">
          <p class="text-[12px] font-semibold text-ink-variant mb-4 uppercase tracking-wide">Recurring task</p>

          <!-- Task row -->
          <div class="flex items-center gap-3 p-3 rounded-md border border-ghost bg-surface-container-low mb-4">
            <span class="flex-shrink-0 rounded-sm" style="width: 14px; height: 14px; border: 1.5px solid var(--outline); border-radius: 3px;"></span>
            <span class="text-ink font-medium flex-1" style="font-size: 14px;">Weekly status report</span>
            <span class="rounded-md font-mono font-semibold text-primary" style="font-size: 11px; padding: 2px 8px; background: rgba(144, 128, 250, 0.15);">weekly</span>
            <span class="font-mono text-ink-outline" style="font-size: 11px;">(generated 4)</span>
          </div>

          <!-- Pattern display -->
          <div class="rounded-md p-3 font-mono bg-surface-container-low border border-ghost" style="font-size: 12px; line-height: 1.7;">
            <div>
              <span class="text-ink-outline">recurrence</span>
              <span class="text-ink-variant mx-1">:</span>
              <span style="color: var(--status-green);">'daily' | 'weekly' | 'biweekly' | 'monthly'</span>
            </div>
            <div>
              <span class="text-ink-outline">generated copies</span>
              <span class="text-ink-variant mx-1">→</span>
              <span class="text-ink-variant">link back to the original recurring template</span>
            </div>
          </div>
        </Card>

        <!-- Right: copy -->
        <SectionHeader
          eyebrow="05 · Recurrence"
          title="Recurring tasks that don't drift."
          subtitle="Daily, weekly, biweekly, monthly. Generated copies link back to the source — edit the template once and future copies follow."
        />

      </div>
    </div>
  </section>

  <!-- ================================================================
       8. REACTIONS + MENTIONS IN COMMENTS
       ================================================================ -->
  <section id="comments" class="py-20 md:py-28 bg-surface-container-low">
    <div class="max-w-[1200px] mx-auto px-6">
      <SectionHeader
        eyebrow="06 · Reactions + comments"
        title="Emoji reactions. @-mentions. Activity diffs."
        align="center"
      />

      <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">

        <Card variant="subtle">
          <p class="text-[14px] font-semibold text-ink mb-2">Reactions</p>
          <p class="text-[13px] text-ink-variant leading-relaxed">
            Per task and per comment. Same notification semantics as chat. React once
            to confirm you've seen it, react again to remove.
          </p>
        </Card>

        <Card variant="subtle">
          <p class="text-[14px] font-semibold text-ink mb-2">Mentions</p>
          <p class="text-[13px] text-ink-variant leading-relaxed">
            @-mention in task description and comments. Notifies the recipient.
            Autocomplete resolves to org members. Searchable across surfaces.
          </p>
        </Card>

        <Card variant="subtle">
          <p class="text-[14px] font-semibold text-ink mb-2">Activity diff</p>
          <p class="text-[13px] text-ink-variant leading-relaxed">
            See exactly what changed — old → new — instead of a flat "changed
            status" line.
          </p>
        </Card>

      </div>
    </div>
  </section>

  <!-- ================================================================
       9. PROJECT ARCHIVE + RECOVERY
       ================================================================ -->
  <section id="archive" class="py-20 md:py-28">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="bg-surface-container-low rounded-lg my-4 p-12 border border-ghost">
        <p class="eyebrow mb-3">Archive</p>
        <h3 class="section-title mb-4">Soft-delete with a 7-day window.</h3>
        <p class="text-[16px] text-ink-variant leading-relaxed max-w-[560px]">
          Archive a project from settings — tasks are hidden from views but preserved
          for audit. Recover within 7 days. After that, soft-deleted forever.
        </p>
      </div>
    </div>
  </section>

  <!-- ================================================================
       10. SURFACE FOOTER + CTA BAND
       ================================================================ -->
  <SurfaceFooter current="tasks" />

  <CTABand
    title="Tasks that close themselves when you ship."
    cta={{ href: '/pricing#waitlist', label: 'Join the waitlist' }}
  />

</Layout>
