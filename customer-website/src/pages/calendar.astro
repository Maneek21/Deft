---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Card from '../components/Card.astro';
import CTABand from '../components/CTABand.astro';
import CalendarDayMock from '../components/mock/CalendarDayMock.astro';
import BriefingMock from '../components/mock/BriefingMock.astro';
import SurfaceFooter from '../components/SurfaceFooter.astro';
---

<Layout
  title="Deft — calendar in the room with the work"
  description="Google Calendar events show up next to your tasks and decisions. Meetings link to the work they're about. Meeting prep auto-generates the morning of. Reminders survive restarts."
>

  <!-- ================================================================
       1. SUBPAGE HERO
       ================================================================ -->
  <div class="relative">
    <div class="hero-bloom" aria-hidden="true"></div>
    <div class="max-w-3xl mx-auto text-center pt-24 pb-16 relative px-6">
      <p class="eyebrow mb-4">Calendar</p>
      <h1 class="display mb-6">Calendar in the room with the work.</h1>
      <p class="lede mx-auto max-w-[600px]">
        Google Calendar events show up next to your tasks and decisions. Meetings link to the
        work they're about. Meeting prep auto-generates the morning of. Reminders survive restarts.
      </p>
    </div>
  </div>

  <!-- ================================================================
       2. BIG VISUAL
       ================================================================ -->
  <div class="mx-auto max-w-3xl mt-4 mb-4 px-6 flex justify-center">
    <CalendarDayMock />
  </div>

  <!-- ================================================================
       3. GOOGLE CALENDAR SYNC
       ================================================================ -->
  <section id="sync" class="py-20 md:py-28">
    <div class="mx-auto max-w-[1200px] px-6">
      <div class="grid grid-cols-1 gap-16 lg:grid-cols-2 lg:items-start">

        <!-- Left: copy -->
        <SectionHeader
          eyebrow="01 · Sync"
          title="Calendar events alongside your work."
          subtitle="Google Calendar events show up next to Slack messages, GitHub PRs, and Gmail threads — in a single timeline. The AI can connect a meeting to the open tasks it's about, with no app-switching."
        />

        <!-- Right: sources card -->
        <Card variant="default">
          <p class="text-[12px] font-semibold text-ink-variant mb-4 uppercase tracking-wide">Event sources</p>

          <div class="flex flex-col gap-3">

            <div class="flex items-center gap-3 py-3" style="border-bottom: 1px solid var(--ghost-border);">
              <span class="flex items-center justify-center rounded-md flex-shrink-0" style="width: 32px; height: 32px; background: rgba(59,130,246,0.12);">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" style="color: var(--status-blue);">
                  <rect x="2" y="3" width="12" height="11" rx="1.5" stroke="currentColor" stroke-width="1.3"/>
                  <path d="M5 2v2M11 2v2M2 7h12" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                </svg>
              </span>
              <div class="flex-1 min-w-0">
                <p class="text-[13px] font-semibold text-ink">Google Calendar</p>
                <p class="font-mono text-[11px] text-ink-outline">47 events this week</p>
              </div>
              <span
                class="font-mono text-[11px] rounded px-1.5 py-0.5 flex-shrink-0"
                style="background: rgba(48,164,108,0.12); color: var(--status-green);"
              >
                synced
              </span>
            </div>

            <div class="flex items-center gap-3 py-3" style="border-bottom: 1px solid var(--ghost-border);">
              <span class="flex items-center justify-center rounded-md flex-shrink-0" style="width: 32px; height: 32px; background: rgba(144,128,250,0.12);">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" style="color: var(--primary);">
                  <path d="M2 12V5a1.5 1.5 0 0 1 1.5-1.5h9A1.5 1.5 0 0 1 14 5v5a1.5 1.5 0 0 1-1.5 1.5H9l-3 2v-2H3.5A1.5 1.5 0 0 1 2 10.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <div class="flex-1 min-w-0">
                <p class="text-[13px] font-semibold text-ink">Deft (internal)</p>
                <p class="font-mono text-[11px] text-ink-outline">12 events this week</p>
              </div>
              <span
                class="font-mono text-[11px] rounded px-1.5 py-0.5 flex-shrink-0"
                style="background: rgba(144,128,250,0.12); color: var(--primary);"
              >
                native
              </span>
            </div>

            <div class="flex items-center gap-3 py-3">
              <span class="flex items-center justify-center rounded-md flex-shrink-0" style="width: 32px; height: 32px; background: rgba(245,166,35,0.12);">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" style="color: var(--status-amber);">
                  <circle cx="8" cy="8" r="5.5" stroke="currentColor" stroke-width="1.3"/>
                  <path d="M5.5 8l1.5 1.5L11 6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <div class="flex-1 min-w-0">
                <p class="text-[13px] font-semibold text-ink">Linked tasks</p>
                <p class="font-mono text-[11px] text-ink-outline">8 events with task refs</p>
              </div>
              <span
                class="font-mono text-[11px] rounded px-1.5 py-0.5 flex-shrink-0"
                style="background: rgba(245,166,35,0.12); color: var(--status-amber);"
              >
                joined
              </span>
            </div>

          </div>

          <div slot="footer">
            <p class="font-mono text-[11px] text-ink-outline">
              All in a single timeline, scoped to your org.
            </p>
          </div>
        </Card>

      </div>
    </div>
  </section>

  <!-- ================================================================
       4. MEETING PREP
       ================================================================ -->
  <section id="prep" class="py-20 md:py-28 bg-surface-container-low">
    <div class="mx-auto max-w-[1200px] px-6">

      <SectionHeader
        eyebrow="02 · Meeting prep"
        title="15 minutes before. Defty has the briefing ready."
        subtitle="15 minutes before the meeting, Defty pulls the attendees, joins them to recent task activity, joins to relevant decisions, and prepares a focused briefing. You read the briefing instead of the calendar invite."
        align="center"
      />

      <div class="mt-12 flex justify-center">
        <BriefingMock />
      </div>

    </div>
  </section>

  <!-- ================================================================
       5. DURABLE REMINDERS
       ================================================================ -->
  <section id="reminders" class="py-20 md:py-28">
    <div class="mx-auto max-w-[1200px] px-6">
      <div class="grid grid-cols-1 gap-16 lg:grid-cols-2 lg:items-start">

        <!-- Left: reminder list -->
        <Card variant="subtle">
          <p class="text-[12px] font-semibold text-ink-variant mb-4 uppercase tracking-wide">Active reminders</p>
          <div class="flex flex-col gap-2">

            {[
              { prefix: '⏰', label: 'ENG-142 due check-in', when: 'in 2h' },
              { prefix: '⏰', label: 'Decision review', when: 'in 3d' },
              { prefix: '⏰', label: 'Customer demo prep', when: 'tomorrow 1:30 PM' },
              { prefix: '⏰', label: 'Standup recap', when: 'daily at 9:30 AM' },
            ].map((r) => (
              <div class="flex items-center gap-3 py-2.5" style="border-bottom: 1px solid var(--ghost-border);">
                <span class="font-mono text-[12px] text-ink-outline flex-shrink-0">{r.prefix}</span>
                <span class="flex-1 text-[13px] text-ink">{r.label}</span>
                <span
                  class="font-mono text-[11px] flex-shrink-0"
                  style="color: var(--primary);"
                >
                  {r.when}
                </span>
              </div>
            ))}

          </div>
        </Card>

        <!-- Right: copy -->
        <SectionHeader
          eyebrow="03 · Reminders"
          title="Durable. Fires even after a restart."
          subtitle="Reminders are stored in the database, not memory. Even after a restart, pending reminders fire on time. The AI can queue reminders the same way you do."
        />

      </div>
    </div>
  </section>

  <!-- ================================================================
       6. CROSS-REFERENCES
       ================================================================ -->
  <section id="cross-refs" class="py-20 md:py-28 bg-surface-container-low">
    <div class="mx-auto max-w-[1200px] px-6">

      <SectionHeader
        eyebrow="04 · Linked to the work"
        title="Meetings linked to tasks. Decisions to attendees."
        align="center"
      />

      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">

        <Card variant="subtle">
          <p class="text-[13px] font-semibold text-ink mb-2">Meeting → Tasks</p>
          <p class="text-[13px] text-ink-variant leading-relaxed">
            A meeting links to the open tasks on its agenda. Click the meeting to see them.
          </p>
        </Card>

        <Card variant="subtle">
          <p class="text-[13px] font-semibold text-ink mb-2">Decision review → Decisions</p>
          <p class="text-[13px] text-ink-variant leading-relaxed">
            Tag the meeting with decisions to be reviewed. Track which got resolved.
          </p>
        </Card>

        <Card variant="subtle">
          <p class="text-[13px] font-semibold text-ink mb-2">Attendees → Members</p>
          <p class="text-[13px] text-ink-variant leading-relaxed">
            Calendar attendees map to org members. The AI knows who was in the room.
          </p>
        </Card>

      </div>
    </div>
  </section>

  <!-- ================================================================
       7. SURFACE FOOTER + CTA BAND
       ================================================================ -->
  <SurfaceFooter current="calendar" />

  <CTABand
    title="Calendar that knows what your work is about."
    cta={{ href: '/pricing#waitlist', label: 'Join the waitlist' }}
  />

</Layout>
